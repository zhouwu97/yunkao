<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableWinAppRunSupport>true</EnableWinAppRunSupport>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
    <ProjectReference Include="../../src/YunKao.Core/YunKao.Core.csproj" />
    <Compile Include="../../src/YunKao.App/Controls/LiquidGlassShader.cs" Link="Controls/LiquidGlassShader.cs" />
    <Compile Include="../../src/YunKao.App/Controls/SwitchTrackShader.cs" Link="Controls/SwitchTrackShader.cs" />
    <Compile Include="../../src/YunKao.App/Controls/LiquidGlassRenderer.cs" Link="Controls/LiquidGlassRenderer.cs" />
    <Compile Include="../../src/YunKao.App/Controls/LiquidGlassToggleSwitch.cs" Link="Controls/LiquidGlassToggleSwitch.cs" />
    <Compile Include="../../src/YunKao.App/Controls/LiquidGlassScene.cs" Link="Controls/LiquidGlassScene.cs" />
    <Compile Include="../../src/YunKao.App/Controls/LiquidGlassScope.cs" Link="Controls/LiquidGlassScope.cs" />
    <Compile Include="../../src/YunKao.App/Services/GlassSettings.cs" Link="Services/GlassSettings.cs" />
    <Compile Include="../../src/YunKao.App/Services/MotionService.cs" Link="Services/MotionService.cs" />
    <Page Include="../../src/YunKao.App/Themes/Tokens.xaml" Link="Themes/Tokens.xaml" />
    <Page Include="../../src/YunKao.App/Themes/GlassToggle.xaml" Link="Themes/GlassToggle.xaml" />
    <Content Include="../../src/YunKao.App/Assets/GlassNotices/*.txt" Link="Assets/GlassNotices/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromResourceIndex="true" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
</Project>
