<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <Grid Padding="14,12,14,14" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Spacing="3">
        <TextBlock Text="诊断" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Worker、WebView2 和服务生命周期事件会脱敏后保留。" Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
      <controls:LiquidButton Label="刷新" Click="OnRefreshClick" HorizontalAlignment="Right" Variant="Soft" />
    </Grid>
    <controls:LiquidCard Grid.Row="1" Variant="Amber" Padding="8">
      <Grid>
        <ListView x:Name="DiagnosticsList" BorderThickness="0" Background="Transparent" />
        <TextBlock x:Name="EmptyText" Text="暂无诊断事件" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}" />
      </Grid>
    </controls:LiquidCard>
  </Grid>
</Page>
