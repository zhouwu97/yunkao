<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls"
    xmlns:helpers="using:YunKao.Helpers"
    xmlns:vm="using:YunKao.ViewModels"
    Background="Transparent">
  <Page.Resources>
    <Style x:Key="CompactRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource RowItemStyle}">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4,0" />
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="诊断"
                         Description="浏览器、后台任务和运行状态。日志会自动隐藏敏感信息。"
                         Status="{x:Bind ViewModel.StatusText, Mode=OneWay}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Click="OnRefreshClick" AutomationProperties.Name="刷新" ToolTipService.ToolTip="刷新" Style="{StaticResource IconButtonStyle}">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
          </Button>
          <Button AutomationProperties.Name="更多诊断操作" ToolTipService.ToolTip="更多操作" Style="{StaticResource IconButtonStyle}">
            <FontIcon Glyph="&#xE712;" FontSize="14" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem Text="导出诊断文件" Click="OnExportLogClick">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="打开日志目录" Click="OnOpenLogDirectoryClick">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Click="OnCopyClick" Style="{StaticResource SecondaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE8C8;" FontSize="12" />
              <TextBlock Text="复制诊断" />
            </StackPanel>
          </Button>
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid x:Name="LayoutViewport" Grid.Row="1" Margin="32,0,32,28" SizeChanged="OnLayoutSizeChanged">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="DiagnosticsLayout" ColumnSpacing="20" RowSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" />
        <RowDefinition Height="2*" />
      </Grid.RowDefinitions>

      <!-- 运行摘要：键值表 -->
      <Grid RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="运行摘要" Style="{StaticResource CardTitleStyle}" />
        <Border Grid.Row="1" Style="{StaticResource GroupStyle}">
          <ListView ItemsSource="{x:Bind ViewModel.ReportItems}" SelectionMode="None" Padding="0,4" ItemContainerStyle="{StaticResource CompactRowStyle}">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportItem">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Label}" FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Border>
      </Grid>

      <!-- 本次任务动态 -->
      <Grid x:Name="ActivitySection" Grid.Column="1" Grid.RowSpan="2" RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="本次任务动态" Style="{StaticResource CardTitleStyle}" />
        <Border Grid.Row="1" Background="{ThemeResource SurfaceSubtleBrush}" CornerRadius="12" Padding="14,12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="10" Background="{ThemeResource SurfaceSubtleBrush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
              <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}">
                <Run Text="AI 辅助 · " /><Run Text="{x:Bind ViewModel.TaskState.AiStatus, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{x:Bind ViewModel.TaskState.AiDetail, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource GroupStyle}">
          <Grid>
            <ListView ItemsSource="{x:Bind ViewModel.TaskState.Activity}" SelectionMode="None" Padding="0,4" ItemContainerStyle="{StaticResource CompactRowStyle}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityEntry">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="6" Height="6" VerticalAlignment="Top" Margin="0,7,0,0">
                      <Ellipse Fill="{StaticResource StatusRunningBrush}" Visibility="{x:Bind helpers:Ui.Collapsed(IsWarning)}" />
                      <Ellipse Fill="{StaticResource StatusPausedBrush}" Visibility="{x:Bind IsWarning}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{x:Bind Time}" FontFamily="{StaticResource NumberFontFamily}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="开始提取后，这里会实时显示每一步。"
                       Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.HasActivity), Mode=OneWay}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}" />
          </Grid>
        </Border>
      </Grid>

      <!-- 诊断事件 -->
      <Grid Grid.Row="1" RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="诊断事件" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
          <Button Content="加载更多" HorizontalAlignment="Right" Margin="0,-6" Click="OnMoreClick" Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" />
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource GroupStyle}">
          <Grid>
            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" Padding="0,4" ItemContainerStyle="{StaticResource CompactRowStyle}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DiagnosticRow">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="104" />
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Time}" FontFamily="{StaticResource NumberFontFamily}" Style="{StaticResource CaptionTextStyle}" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Level}" FontSize="12" Margin="0,1,0,0"
                               Visibility="{x:Bind helpers:Ui.Collapsed(IsWarning)}"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Level}" FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0"
                               Visibility="{x:Bind IsWarning}"
                               Foreground="{ThemeResource WarningTextBrush}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
    </ScrollViewer>
    </Grid>
  </Grid>
</Page>
