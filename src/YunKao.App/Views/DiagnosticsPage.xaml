<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <Grid Padding="14,12,14,14" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Spacing="3">
        <TextBlock Text="诊断" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Worker、WebView2 和服务生命周期事件会脱敏后保留。" Style="{StaticResource SecondaryTextStyle}" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
      </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
         <controls:LiquidButton Label="复制诊断" Click="OnCopyClick" Variant="Soft" />
         <controls:LiquidButton Label="导出日志" Click="OnExportLogClick" Variant="Ghost" />
         <controls:LiquidButton Label="打开日志" Click="OnOpenLogDirectoryClick" Variant="Ghost" />
         <controls:LiquidButton Label="刷新" Click="OnRefreshClick" Variant="Soft" />
         <controls:LiquidButton x:Name="MoreButton" Label="加载更多" Click="OnMoreClick" Variant="Ghost" IsEnabled="False" />
       </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <controls:LiquidCard Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Text="运行摘要" Style="{StaticResource CardTitleStyle}" />
            <TextBlock x:Name="ReportText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </controls:LiquidCard>
        <controls:LiquidCard Padding="8">
          <Grid MinHeight="180">
            <ListView x:Name="DiagnosticsList" BorderThickness="0" Background="Transparent" />
            <TextBlock x:Name="EmptyText" Text="暂无诊断事件" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}" />
          </Grid>
        </controls:LiquidCard>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
