<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="18,16,18,24" Spacing="14" MaxWidth="760">
      <StackPanel Spacing="3">
        <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="第一阶段先固定信息架构，服务接入后再绑定持久化配置。"
                   Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>

      <Border Style="{StaticResource GlassCardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="账号" Style="{StaticResource SectionTitleStyle}" />
          <TextBox Header="云考账号" PlaceholderText="后续接入 Credential Manager" IsEnabled="False" />
          <PasswordBox Header="云考密码" PlaceholderText="不会写入 settings.json" IsEnabled="False" />
          <CheckBox Content="自动填写登录信息" IsChecked="True" IsEnabled="False" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="导出" Style="{StaticResource SectionTitleStyle}" />
          <TextBox Header="默认目录" PlaceholderText="后续接入 ExportService" IsEnabled="False" />
          <TextBox Header="文件名前缀" Text="yunkao" IsEnabled="False" />
          <ComboBox Header="默认格式" SelectedIndex="0" IsEnabled="False">
            <ComboBoxItem Content="PDF" />
            <ComboBoxItem Content="DOCX" />
            <ComboBoxItem Content="Markdown" />
            <ComboBoxItem Content="TXT" />
          </ComboBox>
          <CheckBox Content="导出后打开文件" IsChecked="True" IsEnabled="False" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCardStyle}">
        <StackPanel Spacing="14">
          <Grid>
            <TextBlock Text="AI 辅助" Style="{StaticResource SectionTitleStyle}" />
            <Border HorizontalAlignment="Right" Style="{StaticResource StatusPillStyle}">
              <TextBlock Text="下一阶段" />
            </Border>
          </Grid>
          <CheckBox Content="启用 AI 补全" IsEnabled="False" />
          <ComboBox Header="Provider" SelectedIndex="0" IsEnabled="False">
            <ComboBoxItem Content="OpenAI-compatible" />
          </ComboBox>
          <TextBox Header="Base URL" PlaceholderText="https://..." IsEnabled="False" />
          <TextBox Header="Model" PlaceholderText="model-name" IsEnabled="False" />
          <PasswordBox Header="API Key" PlaceholderText="仅保存到系统凭据库" IsEnabled="False" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
          <RadioButtons Header="背景材质" SelectedIndex="0" IsEnabled="False">
            <x:String>Desktop Acrylic</x:String>
            <x:String>Mica</x:String>
            <x:String>Solid</x:String>
          </RadioButtons>
          <RadioButtons Header="透明度" SelectedIndex="0" IsEnabled="False">
            <x:String>标准</x:String>
            <x:String>更透明</x:String>
          </RadioButtons>
          <RadioButtons Header="动画" SelectedIndex="0" IsEnabled="False">
            <x:String>开</x:String>
            <x:String>减少动画</x:String>
          </RadioButtons>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource NoticeCardStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE946;" Foreground="{StaticResource AmberBrush}" />
          <TextBlock Text="设置控件已按最终信息架构预留；真正的读写将在配置迁移阶段接入。"
                     TextWrapping="Wrap"
                     Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
