<?xml version="1.0" encoding="utf-8"?>
<!-- 设置：分组行布局（左侧说明，右侧控件）。普通项自动保存，密码与 API Key 单独保存。 -->
<Page
    x:Class="YunKao.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls"
    Background="Transparent">
  <Page.Resources>
    <Style x:Key="RowGridStyle" TargetType="Grid">
      <Setter Property="Padding" Value="20,14" />
      <Setter Property="ColumnSpacing" Value="24" />
      <Setter Property="MinHeight" Value="62" />
    </Style>
    <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="RowDividerStyle" TargetType="Rectangle">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{ThemeResource DividerBrush}" />
      <Setter Property="Margin" Value="20,0" />
    </Style>
    <Style x:Key="GroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
      <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
      <Setter Property="Margin" Value="4,0,0,10" />
    </Style>
    <Style x:Key="RowToggleStyle" TargetType="controls:LiquidGlassToggleSwitch" BasedOn="{StaticResource LiquidGlassToggleStyle}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,-12,0" />
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader x:Name="Header"
                         Title="设置"
                         Description="常规设置自动保存。修改密码或 API Key 后，请点击对应的保存按钮。">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="RetrySaveButton" Content="重试保存" Click="OnRetrySaveClick" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" />
          <Button AutomationProperties.Name="跳转到设置分组" Style="{StaticResource SecondaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE8FD;" FontSize="14" />
              <TextBlock Text="跳转到" />
              <FontIcon Glyph="&#xE70D;" FontSize="10" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuFlyoutItem Text="外观" Tag="Appearance" Click="OnJumpToGroup"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem Text="云考账号" Tag="Account" Click="OnJumpToGroup"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem Text="导出" Tag="Export" Click="OnJumpToGroup"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem Text="AI 辅助" Tag="Ai" Click="OnJumpToGroup"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem Text="数据与诊断" Tag="Data" Click="OnJumpToGroup"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="SettingsBody" Padding="32,0,32,32" SizeChanged="OnSettingsSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="820" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="28">

          <!-- 外观 -->
          <StackPanel x:Name="AppearanceGroup">
            <TextBlock Text="外观" Style="{StaticResource GroupTitleStyle}" />
            <controls:GlassPanel Style="{StaticResource GlassGroupStyle}">
              <StackPanel>
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="主题" Style="{StaticResource RowTitleStyle}" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource SegmentTrackStyle}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" GroupName="Theme" Checked="OnThemeChanged" Style="{StaticResource SegmentRadioStyle}" />
                      <RadioButton x:Name="ThemeLightRadio" Content="浅色" GroupName="Theme" Checked="OnThemeChanged" Style="{StaticResource SegmentRadioStyle}" />
                      <RadioButton x:Name="ThemeDarkRadio" Content="深色" GroupName="Theme" Checked="OnThemeChanged" Style="{StaticResource SegmentRadioStyle}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="窗口材质" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="亚克力与云母支持液态玻璃，纯色使用实体面板。" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource SegmentTrackStyle}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="AcrylicRadio" Content="亚克力" GroupName="BackdropMaterial" Checked="OnAppearanceChanged" Style="{StaticResource SegmentRadioStyle}" />
                      <RadioButton x:Name="MicaRadio" Content="云母" GroupName="BackdropMaterial" Checked="OnAppearanceChanged" Style="{StaticResource SegmentRadioStyle}" />
                      <RadioButton x:Name="SolidRadio" Content="纯色" GroupName="BackdropMaterial" Checked="OnAppearanceChanged" Style="{StaticResource SegmentRadioStyle}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="玻璃透明度" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="调整导航、工具栏与玻璃面板的着色强度。" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource SegmentTrackStyle}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ClearRadio" Content="清晰" GroupName="BackdropClarity" Checked="OnAppearanceChanged" Style="{StaticResource SegmentRadioStyle}" />
                      <RadioButton x:Name="StandardRadio" Content="标准" GroupName="BackdropClarity" Checked="OnAppearanceChanged" Style="{StaticResource SegmentRadioStyle}" />
                      <RadioButton x:Name="TransparentRadio" Content="通透" GroupName="BackdropClarity" Checked="OnAppearanceChanged" Style="{StaticResource SegmentRadioStyle}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="减少动画" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="关闭导航滑动、指针光效与按钮回弹；系统关闭动画时自动生效" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <controls:LiquidGlassToggleSwitch x:Name="ReduceMotionToggle" AutomationProperties.Name="减少动画" Grid.Column="1" Toggled="OnReduceMotionToggled" Style="{StaticResource RowToggleStyle}" />
                </Grid>
              </StackPanel>
            </controls:GlassPanel>
          </StackPanel>

          <!-- 云考账号 -->
          <StackPanel x:Name="AccountGroup">
            <TextBlock Text="云考账号" Style="{StaticResource GroupTitleStyle}" />
            <controls:GlassPanel Style="{StaticResource GlassGroupStyle}">
              <StackPanel>
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="学号 / 用户名" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="学校代码固定为 u101441" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <TextBox x:Name="YunKaoUserBox" AutomationProperties.Name="学号或用户名" Grid.Column="1" Width="280" VerticalAlignment="Center" PlaceholderText="例如 20260001" TextChanged="OnTextSettingChanged" />
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="密码" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="只保存在系统凭据库，不进入导出文件和日志" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PasswordBox x:Name="YunKaoPasswordBox" Width="200" PasswordRevealMode="Hidden"
                                 PlaceholderText="输入密码" AutomationProperties.Name="密码" />
                    <Button Content="保存" AutomationProperties.Name="保存密码" Click="OnSavePasswordClick" Style="{StaticResource SecondaryButtonStyle}" />
                  </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="记住密码" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="在云考登录页自动填写；关闭后会清除已保存的密码" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <controls:LiquidGlassToggleSwitch x:Name="RememberPasswordToggle" AutomationProperties.Name="记住密码" Grid.Column="1" Toggled="OnSettingChanged" Style="{StaticResource RowToggleStyle}" />
                </Grid>
              </StackPanel>
            </controls:GlassPanel>
          </StackPanel>

          <!-- 导出 -->
          <StackPanel x:Name="ExportGroup">
            <TextBlock Text="导出" Style="{StaticResource GroupTitleStyle}" />
            <controls:GlassPanel Style="{StaticResource GlassGroupStyle}">
              <StackPanel>
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="默认目录" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="留空使用系统文档目录" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="480">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExportDirectoryBox" AutomationProperties.Name="默认导出目录" MinWidth="220" PlaceholderText="文档" TextChanged="OnTextSettingChanged" />
                    <Button Grid.Column="1" Content="浏览" Click="OnBrowseExportFolderClick" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Grid.Column="2" Click="OnOpenExportFolderClick" AutomationProperties.Name="打开导出目录" ToolTipService.ToolTip="打开导出目录" Style="{StaticResource IconButtonStyle}">
                      <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                  </Grid>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="文件名前缀" VerticalAlignment="Center" Style="{StaticResource RowTitleStyle}" />
                  <TextBox x:Name="ExportPrefixBox" AutomationProperties.Name="文件名前缀" Grid.Column="1" Width="240" VerticalAlignment="Center" TextChanged="OnTextSettingChanged" />
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="默认格式" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="任务卡「导出题库」使用此格式；PDF 需要本机安装 Word 或 WPS" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <ComboBox x:Name="ExportFormatCombo" AutomationProperties.Name="默认导出格式" Grid.Column="1" MinWidth="150" VerticalAlignment="Center" SelectionChanged="OnSelectionSettingChanged">
                    <ComboBoxItem Tag="PDF" Content="PDF" />
                    <ComboBoxItem Tag="DOCX" Content="DOCX" />
                    <ComboBoxItem Tag="MD" Content="Markdown" />
                    <ComboBoxItem Tag="TXT" Content="TXT" />
                  </ComboBox>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="导出后自动打开文件" VerticalAlignment="Center" Style="{StaticResource RowTitleStyle}" />
                  <controls:LiquidGlassToggleSwitch x:Name="AutoOpenToggle" AutomationProperties.Name="导出后自动打开文件" Grid.Column="1" Toggled="OnSettingChanged" Style="{StaticResource RowToggleStyle}" />
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="练习版" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="导出时隐藏答案和解析" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <controls:LiquidGlassToggleSwitch x:Name="ExportWithoutAnswersToggle" AutomationProperties.Name="练习版，隐藏答案和解析" Grid.Column="1" Toggled="OnSettingChanged" Style="{StaticResource RowToggleStyle}" />
                </Grid>
              </StackPanel>
            </controls:GlassPanel>
          </StackPanel>

          <!-- AI 辅助 -->
          <StackPanel x:Name="AiGroup">
            <Grid Margin="0,0,0,10">
              <TextBlock Text="AI 辅助" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,0" VerticalAlignment="Center" />
              <Border HorizontalAlignment="Right" CornerRadius="10" Padding="10,3" Background="{ThemeResource AccentSoftBrush}">
                <TextBlock x:Name="AiKeyStatusText" Text="未保存 Key" FontSize="12" Foreground="{ThemeResource TextAccentBrush}" />
              </Border>
            </Grid>
            <controls:GlassPanel Style="{StaticResource GlassGroupStyle}">
              <StackPanel>
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="自动补全缺失答案" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="缺少答案的题目会发送给所选服务商；结果需自行核对，导出时标明 AI 来源与置信度" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <controls:LiquidGlassToggleSwitch x:Name="AiEnabledToggle" AutomationProperties.Name="自动补全缺失答案" Grid.Column="1" Toggled="OnSettingChanged" Style="{StaticResource RowToggleStyle}" />
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="服务商" VerticalAlignment="Center" Style="{StaticResource RowTitleStyle}" />
                  <ComboBox x:Name="ProviderCombo" AutomationProperties.Name="AI 服务商" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnProviderChanged">
                    <ComboBoxItem Tag="openai" Content="OpenAI / GPT" />
                    <ComboBoxItem Tag="deepseek" Content="DeepSeek" />
                    <ComboBoxItem Tag="kimi" Content="Kimi / Moonshot" />
                    <ComboBoxItem Tag="qwen" Content="千问 / Qwen" />
                    <ComboBoxItem Tag="glm" Content="智谱 / GLM" />
                    <ComboBoxItem Tag="mimo" Content="小米 MiMo" />
                    <ComboBoxItem Tag="custom" Content="自定义兼容接口" />
                  </ComboBox>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="接口地址" VerticalAlignment="Center" Style="{StaticResource RowTitleStyle}" />
                  <TextBox x:Name="AiBaseUrlBox" AutomationProperties.Name="AI 接口地址" Grid.Column="1" Width="320" VerticalAlignment="Center" PlaceholderText="https://.../v1" TextChanged="OnTextSettingChanged" />
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="模型名称" VerticalAlignment="Center" Style="{StaticResource RowTitleStyle}" />
                  <TextBox x:Name="AiModelBox" AutomationProperties.Name="模型名称" Grid.Column="1" Width="320" VerticalAlignment="Center" PlaceholderText="模型名称" TextChanged="OnTextSettingChanged" />
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="API Key" VerticalAlignment="Center" Style="{StaticResource RowTitleStyle}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PasswordBox x:Name="AiKeyBox" Width="200" PasswordRevealMode="Hidden"
                                 PlaceholderText="输入 API Key" AutomationProperties.Name="API Key" />
                    <Button Content="保存" AutomationProperties.Name="保存 API Key" Click="OnSaveAiKeyClick" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="清除" Click="OnClearAiKeyClick" Style="{StaticResource SubtleButtonStyle}" />
                  </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <Grid Style="{StaticResource RowGridStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="允许发送题目图片" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock Text="仅对支持视觉的模型生效" Style="{StaticResource RowDescriptionStyle}" />
                  </StackPanel>
                  <controls:LiquidGlassToggleSwitch x:Name="AiSupportsImagesToggle" AutomationProperties.Name="允许发送题目图片" Grid.Column="1" Toggled="OnSettingChanged" Style="{StaticResource RowToggleStyle}" />
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <StackPanel Padding="20,14" Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="测试连接" Click="OnTestAiConnectionClick" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="获取模型" Click="OnGetAiModelsClick" Style="{StaticResource SubtleButtonStyle}" />
                    <Button x:Name="ApplyPresetButton" Content="应用推荐配置" Click="OnApplyPresetClick" Visibility="Collapsed" Style="{StaticResource SubtleButtonStyle}" />
                  </StackPanel>
                  <TextBlock x:Name="AiTestResultText" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                </StackPanel>
              </StackPanel>
            </controls:GlassPanel>
          </StackPanel>

          <!-- 数据与诊断 -->
          <StackPanel x:Name="DataGroup">
            <TextBlock Text="数据与诊断" Style="{StaticResource GroupTitleStyle}" />
            <controls:GlassPanel Style="{StaticResource GlassGroupStyle}">
              <Grid Style="{StaticResource RowGridStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="本地数据与日志" Style="{StaticResource RowTitleStyle}" />
                  <TextBlock Text="题库快照、导出记录与运行日志都保存在本机" Style="{StaticResource RowDescriptionStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="数据目录" Click="OnOpenDataFolderClick" Style="{StaticResource SecondaryButtonStyle}" />
                  <Button Content="日志目录" Click="OnOpenLogFolderClick" Style="{StaticResource SecondaryButtonStyle}" />
                  <Button Content="复制诊断" Click="OnCopyDiagnosticsClick" Style="{StaticResource SubtleButtonStyle}" />
                </StackPanel>
              </Grid>
            </controls:GlassPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
