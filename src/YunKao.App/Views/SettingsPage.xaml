<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="14,12,14,28" Spacing="12" MaxWidth="860">
      <Grid>
        <StackPanel Spacing="3">
          <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="配置会写入本地 settings.json；密码和 API Key 只进入系统凭据库。"
                     Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
          <controls:LiquidButton x:Name="SaveButton" Label="保存设置" Click="OnSaveClick" Variant="Primary" />
        </StackPanel>
      </Grid>

      <controls:LiquidCard Padding="16">
        <StackPanel Spacing="14">
          <TextBlock Text="云考账号" Style="{StaticResource SectionTitleStyle}" />
          <TextBox x:Name="YunKaoUserBox" Header="学号 / 用户名" PlaceholderText="例如 20260001" />
          <PasswordBox x:Name="YunKaoPasswordBox" Header="密码" PlaceholderText="留空表示保持现有凭据" />
          <CheckBox x:Name="RememberPasswordCheckBox" Content="记住密码并在白名单页面自动填写" />
          <TextBlock Text="学校代码固定为 u101441；凭据不会进入导出文件或诊断日志。"
                     TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
      </controls:LiquidCard>

      <controls:LiquidCard Padding="16">
        <StackPanel Spacing="14">
          <TextBlock Text="导出" Style="{StaticResource SectionTitleStyle}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExportDirectoryBox" Grid.Column="0" Header="默认导出目录" PlaceholderText="留空使用系统文档目录" />
            <Button Grid.Column="1" Content="选择文件夹" Click="OnBrowseExportFolderClick" VerticalAlignment="Bottom" Height="36" Style="{StaticResource QuietButtonStyle}" />
            <Button Grid.Column="2" Content="打开" Click="OnOpenExportFolderClick" VerticalAlignment="Bottom" Height="36" Style="{StaticResource QuietButtonStyle}" />
          </Grid>
          <TextBox x:Name="ExportPrefixBox" Header="文件名前缀" />
          <ComboBox x:Name="ExportFormatCombo" Header="默认格式">
            <ComboBoxItem Tag="PDF" Content="PDF" />
            <ComboBoxItem Tag="DOCX" Content="DOCX" />
            <ComboBoxItem Tag="MD" Content="Markdown" />
            <ComboBoxItem Tag="TXT" Content="TXT" />
          </ComboBox>
          <CheckBox x:Name="AutoOpenCheckBox" Content="导出后自动打开文件" />
          <CheckBox x:Name="ExportWithoutAnswersCheckBox" Content="导出练习版（隐藏答案和解析）" />
        </StackPanel>
      </controls:LiquidCard>

      <controls:LiquidCard Padding="16">
        <StackPanel Spacing="14">
          <Grid>
            <TextBlock Text="AI 辅助" Style="{StaticResource SectionTitleStyle}" />
            <Border HorizontalAlignment="Right" Style="{StaticResource StatusPillStyle}">
              <TextBlock x:Name="AiKeyStatusText" Text="未保存 Key" />
            </Border>
          </Grid>
          <CheckBox x:Name="AiEnabledCheckBox" Content="自动补全网页缺失答案" />
          <ComboBox x:Name="ProviderCombo" Header="Provider" SelectionChanged="OnProviderChanged">
            <ComboBoxItem Tag="openai" Content="OpenAI / GPT" />
            <ComboBoxItem Tag="deepseek" Content="DeepSeek" />
            <ComboBoxItem Tag="kimi" Content="Kimi / Moonshot" />
            <ComboBoxItem Tag="qwen" Content="千问 / Qwen" />
            <ComboBoxItem Tag="glm" Content="智谱 / GLM" />
            <ComboBoxItem Tag="mimo" Content="小米 MiMo" />
            <ComboBoxItem Tag="custom" Content="自定义兼容接口" />
          </ComboBox>
          <TextBox x:Name="AiBaseUrlBox" Header="Base URL" PlaceholderText="https://.../v1" />
          <TextBox x:Name="AiModelBox" Header="Model" PlaceholderText="模型名称" />
          <PasswordBox x:Name="AiKeyBox" Header="API Key" PlaceholderText="留空保持已保存的 Key" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:LiquidButton Label="测试连接" Click="OnTestAiConnectionClick" Variant="Soft" />
            <controls:LiquidButton Label="获取模型" Click="OnGetAiModelsClick" Variant="Ghost" />
            <controls:LiquidButton x:Name="ApplyPresetButton" Label="应用推荐配置" Click="OnApplyPresetClick" Variant="Ghost" Visibility="Collapsed" />
          </StackPanel>
          <TextBlock x:Name="AiTestResultText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
          <CheckBox x:Name="ClearAiKeyCheckBox" Content="清除已保存的 API Key" />
          <CheckBox x:Name="AiSupportsImagesCheckBox" Content="允许把题目中的远程图片交给支持视觉的模型" />
          <TextBlock Text="AI 返回仅用于辅助补全，导出时会标明 AI 来源和置信度。"
                     TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
      </controls:LiquidCard>

      <controls:LiquidCard Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="数据与诊断" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Text="管理本地存储的数据目录与运行日志。" Style="{StaticResource SecondaryTextStyle}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:LiquidButton Label="打开数据目录" Click="OnOpenDataFolderClick" Variant="Soft" />
            <controls:LiquidButton Label="打开日志目录" Click="OnOpenLogFolderClick" Variant="Soft" />
            <controls:LiquidButton Label="一键复制诊断" Click="OnCopyDiagnosticsClick" Variant="Ghost" />
          </StackPanel>
        </StackPanel>
      </controls:LiquidCard>

      <controls:LiquidCard Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
           <TextBlock Text="材质、透明度和减少动画选项会保存到本地配置。" Style="{StaticResource SecondaryTextStyle}" />
          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Text="背景材质" Style="{StaticResource SmallLabelStyle}" />
               <RadioButton x:Name="AcrylicRadio" Content="Liquid Acrylic" IsChecked="True" GroupName="BackdropMaterial" />
               <RadioButton x:Name="MicaRadio" Content="Mica" GroupName="BackdropMaterial" />
               <RadioButton x:Name="SolidRadio" Content="Solid" GroupName="BackdropMaterial" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="透明强度" Style="{StaticResource SmallLabelStyle}" />
               <RadioButton x:Name="ClearRadio" Content="清晰" GroupName="BackdropClarity" />
               <RadioButton x:Name="StandardRadio" Content="标准" IsChecked="True" GroupName="BackdropClarity" />
               <RadioButton x:Name="TransparentRadio" Content="通透" GroupName="BackdropClarity" />
            </StackPanel>
          </Grid>
          <ToggleSwitch x:Name="ReduceMotionToggle" Header="减少动画" OffContent="标准动效" OnContent="已减少" Toggled="OnReduceMotionToggled" />
        </StackPanel>
      </controls:LiquidCard>

      <Border Style="{StaticResource NoticeCardStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE946;" Foreground="{StaticResource IceBlueBrush}" />
          <TextBlock Text="融智云考已内置独立 Worker 协议引擎与本地数据库；导出文档无需安装额外后台服务。"
                     TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
