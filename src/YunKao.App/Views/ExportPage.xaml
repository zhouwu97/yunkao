<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls"
    xmlns:helpers="using:YunKao.Helpers"
    xmlns:vm="using:YunKao.ViewModels"
    Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="导出记录"
                         Description="最近生成的 PDF、DOCX、Markdown 和 TXT 文件。"
                         Status="{x:Bind ViewModel.StatusText, Mode=OneWay}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="加载更多" Click="OnMoreClick" Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" />
          <Button Click="OnRefreshClick" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE72C;" FontSize="12" />
              <TextBlock Text="刷新" />
            </StackPanel>
          </Button>
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid Grid.Row="1" Margin="32,0,32,28">
      <Border Style="{StaticResource GroupStyle}"
              VerticalAlignment="Top"
              Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.IsEmpty), Mode=OneWay}">
        <ListView ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="None"
                  Padding="0,4"
                  ItemContainerStyle="{StaticResource RowItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:ExportRow">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" Background="{ThemeResource SurfaceSubtleBrush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Format}"
                             FontSize="10"
                             FontWeight="Bold"
                             FontFamily="{StaticResource NumberFontFamily}"
                             Foreground="{ThemeResource TextSecondaryBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind FileName}"
                             TextTrimming="CharacterEllipsis"
                             ToolTipService.ToolTip="{x:Bind FilePath}"
                             Style="{StaticResource CardTitleStyle}" />
                  <TextBlock Text="{x:Bind Meta}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Content="打开" Tag="{x:Bind}" IsEnabled="{x:Bind FileExists}" Click="OnOpenClick" MinHeight="30" Padding="14,4" Style="{StaticResource SecondaryButtonStyle}" />
                  <Button Tag="{x:Bind}" Click="OnOpenFolderClick" AutomationProperties.Name="打开所在文件夹" ToolTipService.ToolTip="打开所在文件夹" Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                  </Button>
                  <Button AutomationProperties.Name="更多导出记录操作" ToolTipService.ToolTip="更多操作" Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="复制完整路径" Tag="{x:Bind}" Click="OnCopyPathClick">
                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="重新导出" Tag="{x:Bind}" IsEnabled="{x:Bind CanReExport}" Click="OnReExportClick">
                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="删除记录" Tag="{x:Bind}" Click="OnDeleteRecordClick">
                          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <controls:EmptyState Glyph="&#xE8B7;"
                           Title="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                           Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                           ActionLabel="前往工作台"
                           ActionClick="OnGoToWorkspaceClick"
                           Margin="0,0,0,60"
                           Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
  </Grid>
</Page>
