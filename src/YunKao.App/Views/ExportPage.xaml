<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <Grid Padding="14,12,14,14" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Spacing="3">
        <TextBlock Text="导出记录" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="最近生成的 PDF、DOCX、Markdown 和 TXT 文件。" Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
         <controls:LiquidButton Label="刷新" Click="OnRefreshClick" Variant="Coral" />
         <controls:LiquidButton x:Name="MoreButton" Label="加载更多" Click="OnMoreClick" Variant="Ghost" IsEnabled="False" />
       </StackPanel>
    </Grid>
    <controls:LiquidCard Grid.Row="1" Variant="Coral" Padding="8">
      <Grid>
        <ListView x:Name="ExportsList" BorderThickness="0" Background="Transparent" />
        <TextBlock x:Name="EmptyText" Text="还没有导出记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}" />
      </Grid>
    </controls:LiquidCard>
  </Grid>
</Page>
