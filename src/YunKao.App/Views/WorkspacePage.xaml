<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <Grid x:Name="PageRoot" Padding="14,8,14,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="ContentGrid" Grid.Row="0" ColumnSpacing="0" SizeChanged="OnContentGridSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <!-- Browser-first：在完成实际测量前不预留右栏，避免首帧把网页压成窄列。 -->
        <ColumnDefinition x:Name="ControlColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="ActionBanner"
                 Grid.Row="0"
                 IsOpen="False"
                 IsClosable="True"
                 CornerRadius="12"
                 Canvas.ZIndex="10">
          <InfoBar.ActionButton>
            <Button x:Name="BannerActionButton" Content="操作" Click="OnBannerActionButtonClick" />
          </InfoBar.ActionButton>
        </InfoBar>
        <controls:BrowserShell x:Name="Browser" Grid.Row="1" />
      </Grid>

      <Border x:Name="DrawerScrim"
              Grid.ColumnSpan="2"
              Background="#0F172A"
              Opacity="0"
              Visibility="Collapsed"
              Canvas.ZIndex="1"
              Tapped="OnDrawerScrimTapped" />

      <Grid x:Name="ControlPanel" Grid.Column="1" Canvas.ZIndex="2" Visibility="Collapsed">
        <Border x:Name="DrawerShell"
                Background="{StaticResource DrawerSurfaceBrush}"
                BorderBrush="{StaticResource DrawerBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <controls:LiquidCard x:Name="TaskCard" Padding="15">
                <StackPanel Spacing="14">
                  <controls:ExtractionPanel x:Name="Extraction" />
                  <Border Height="1" Background="{StaticResource LiquidInnerBorderBrush}" />
                  <controls:ProgressCard x:Name="Progress" />
                </StackPanel>
              </controls:LiquidCard>

              <controls:LiquidCard x:Name="ToolsCard" Padding="14">
                <controls:ExportCard x:Name="Export" />
              </controls:LiquidCard>

              <!-- AI 运行细节和事件仅进入诊断页，工作台只保留下一步决策所需的信息。 -->
              <controls:AiStatusCard x:Name="AiStatus" Visibility="Collapsed" />
              <controls:EventList x:Name="Events" Visibility="Collapsed" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <controls:LiquidButton x:Name="DrawerToggle"
                             Grid.ColumnSpan="2"
                             Label="任务状态"
                             Variant="Primary"
                             ShadowEnabled="True"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Click="OnDrawerToggleClick"
                             Visibility="Collapsed"
                             Canvas.ZIndex="3"
                             Margin="0,0,8,8" />
    </Grid>
  </Grid>
</Page>
