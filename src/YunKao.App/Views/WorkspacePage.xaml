<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <Grid Padding="18,16,18,18" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel Spacing="3">
        <TextBlock Text="工作台" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="把浏览、提取和导出放在同一个安静的工作区。"
                   Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
      <Border HorizontalAlignment="Right" Style="{StaticResource StatusPillStyle}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" />
          <TextBlock Text="本地模式" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="304" />
      </Grid.ColumnDefinitions>

      <controls:BrowserShell x:Name="Browser" Grid.Column="0" />

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <controls:ExtractionPanel x:Name="Extraction" />
          <controls:ProgressCard x:Name="Progress" />
          <controls:AiStatusCard x:Name="AiStatus" />
          <controls:EventList x:Name="Events" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
