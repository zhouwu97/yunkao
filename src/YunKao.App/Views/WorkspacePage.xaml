<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <Grid x:Name="PageRoot" Padding="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="ContentGrid" Grid.Row="0" ColumnSpacing="0" SizeChanged="OnContentGridSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <!-- Browser-first：在完成实际测量前不预留右栏，避免首帧把网页压成窄列。 -->
        <ColumnDefinition x:Name="ControlColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="ActionBanner"
                 Grid.Row="0"
                 IsOpen="False"
                 IsClosable="True"
                 CornerRadius="12"
                 Canvas.ZIndex="10">
          <InfoBar.ActionButton>
            <Button x:Name="BannerActionButton" Content="操作" Click="OnBannerActionButtonClick" />
          </InfoBar.ActionButton>
        </InfoBar>
        <controls:BrowserShell x:Name="Browser" Grid.Row="1" />
      </Grid>

      <Border x:Name="DrawerScrim"
              Grid.ColumnSpan="2"
              Background="#0F172A"
              Opacity="0"
              Visibility="Collapsed"
              Canvas.ZIndex="1"
              Tapped="OnDrawerScrimTapped" />

      <Grid x:Name="ControlPanel" Grid.Column="0" Grid.ColumnSpan="2" Canvas.ZIndex="2" Visibility="Collapsed">
        <Border x:Name="DrawerShell"
                Background="{StaticResource DrawerSurfaceBrush}"
                BorderBrush="{StaticResource DrawerBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D2;" FontSize="15" Foreground="{StaticResource BlueDeepBrush}" />
                <TextBlock Text="提取任务" Style="{StaticResource SectionTitleStyle}" />
              </StackPanel>
              <Button HorizontalAlignment="Right"
                      Click="OnDrawerCloseClick"
                      ToolTipService.ToolTip="关闭任务面板"
                      Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE711;" FontSize="13" />
              </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <controls:ExtractionPanel x:Name="Extraction" />
                <Border Height="1" Background="{StaticResource LiquidInnerBorderBrush}" />
                <controls:ProgressCard x:Name="Progress" />
                <Border Height="1" Background="{StaticResource LiquidInnerBorderBrush}" />
                <controls:ExportCard x:Name="Export" />

                <!-- AI 运行细节和事件仅进入诊断页，工作台只保留下一步决策所需的信息。 -->
                <controls:AiStatusCard x:Name="AiStatus" Visibility="Collapsed" />
                <controls:EventList x:Name="Events" Visibility="Collapsed" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Page>
