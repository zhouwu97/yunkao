<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YunKao.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="18,16,18,18" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Spacing="3">
        <TextBlock Text="历史记录" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="查看提取会话、题目数量和中断状态。" Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
      <Button Content="刷新" Click="OnRefreshClick" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" />
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}">
      <Grid>
        <ListView x:Name="SessionsList" BorderThickness="0" Background="Transparent" />
        <TextBlock x:Name="EmptyText" Text="还没有提取记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}" />
      </Grid>
    </Border>
  </Grid>
</Page>
