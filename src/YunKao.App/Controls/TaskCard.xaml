<?xml version="1.0" encoding="utf-8"?>
<!--
  任务卡：侧边栏中常驻的提取控制中心。
  展开：状态 → 大号计数与进度 → 提示 → 唯一主操作 → 快捷导出。
  紧凑：一颗玻璃按钮（状态点 + 已保存数），点击弹出完整任务卡。
-->
<UserControl
    x:Class="YunKao.Controls.TaskCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls"
    xmlns:helpers="using:YunKao.Helpers">
  <Grid>
    <controls:GlassPanel x:Name="ExpandedRoot" Padding="16,13,16,16">
      <StackPanel Spacing="10">
        <Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Grid Width="8" Height="8" VerticalAlignment="Center">
              <Ellipse Fill="{x:Bind helpers:Ui.StatusBrush(ViewModel.StatusKind), Mode=OneWay}" Opacity="0.3" Margin="-3" />
              <Ellipse Fill="{x:Bind helpers:Ui.StatusBrush(ViewModel.StatusKind), Mode=OneWay}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource SidebarTextSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <Button HorizontalAlignment="Right"
                  Margin="0,-6,-8,-6"
                  AutomationProperties.Name="更多任务操作"
                  ToolTipService.ToolTip="更多操作"
                  Style="{StaticResource SidebarIconButtonStyle}">
            <FontIcon Glyph="&#xE712;" FontSize="13" />
            <Button.Flyout>
              <MenuFlyout Placement="RightEdgeAlignedTop">
                <MenuFlyoutItem Text="停止任务" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind ViewModel.ShowStop, Mode=OneWay}">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="新建提取任务（保留历史）" Command="{x:Bind ViewModel.RestartCommand}">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="移出工作台（保留历史）" Command="{x:Bind ViewModel.ClearCommand}">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.HasInterrupted, Mode=OneWay}" />
                <MenuFlyoutItem Text="{x:Bind ViewModel.RestoreLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RestoreCommand}"
                                Visibility="{x:Bind ViewModel.HasInterrupted, Mode=OneWay}">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.SavedCount, Mode=OneWay}" Style="{StaticResource DisplayNumberStyle}" LineHeight="36" />
            <TextBlock Text="题已保存" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="12" Foreground="{ThemeResource SidebarTextSecondaryBrush}" />
          </StackPanel>
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource SidebarTextTertiaryBrush}"
                       Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}">
              <Run Text="· 第 " /><Run Text="{x:Bind ViewModel.Current, Mode=OneWay}" /><Run Text=" / " /><Run Text="{x:Bind ViewModel.Total, Mode=OneWay}" /><Run Text=" 题" />
            </TextBlock>
          <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}"
                       Minimum="0" Maximum="100" Height="3" MinHeight="3" CornerRadius="2" />
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.HintText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   MaxLines="3"
                   TextTrimming="CharacterEllipsis"
                   FontSize="12"
                   LineHeight="18"
                   Foreground="{ThemeResource SidebarTextSecondaryBrush}" />

        <Button Content="{x:Bind ViewModel.ActionLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.PrimaryCommand}"
                Visibility="{x:Bind ViewModel.IsActionEnabled, Mode=OneWay}"
                Style="{x:Bind helpers:Ui.ToneStyle(ViewModel.Tone), Mode=OneWay}"
                HorizontalAlignment="Stretch"
                MinHeight="36" />

        <Button Content="停止任务，保留题目" Command="{x:Bind ViewModel.StopCommand}"
                Visibility="{x:Bind ViewModel.ShowStop, Mode=OneWay}"
                Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" />

        <Button Content="{x:Bind ViewModel.RestoreLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RestoreCommand}"
                Visibility="{x:Bind ViewModel.HasInterrupted, Mode=OneWay}"
                Style="{StaticResource SidebarButtonStyle}" HorizontalAlignment="Stretch" />

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasQuestions, Mode=OneWay}">
          <Rectangle Height="1" Fill="{ThemeResource SidebarDividerBrush}" Margin="0,2,0,0" />
          <Grid>
            <TextBlock Text="快捷导出" Style="{StaticResource SidebarLabelStyle}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.ExportStateText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource SidebarTextTertiaryBrush}" />
          </Grid>
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="PDF" Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="pdf" HorizontalAlignment="Stretch" Style="{StaticResource SidebarButtonStyle}" />
            <Button Grid.Column="1" Content="DOCX" Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="docx" HorizontalAlignment="Stretch" Style="{StaticResource SidebarButtonStyle}" />
            <Button Grid.Column="2" AutomationProperties.Name="更多导出选项" ToolTipService.ToolTip="更多格式与练习版" Style="{StaticResource SidebarButtonStyle}" Padding="8,4">
              <FontIcon Glyph="&#xE712;" FontSize="12" />
              <Button.Flyout>
                <MenuFlyout Placement="RightEdgeAlignedBottom">
                  <ToggleMenuFlyoutItem Text="练习版（隐藏答案和解析）" IsChecked="{x:Bind ViewModel.PracticeMode, Mode=TwoWay}" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="导出 Markdown (.md)" Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="md" />
                  <MenuFlyoutItem Text="导出纯文本 (.txt)" Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="txt" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <CheckBox Content="练习版（隐藏答案）" IsChecked="{x:Bind ViewModel.PracticeMode, Mode=TwoWay}"
                    FontSize="12" MinWidth="0" Padding="0"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ExportVersionText, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </controls:GlassPanel>

    <!-- 紧凑：玻璃状态按钮 -->
    <Button x:Name="CompactButton"
            Visibility="Collapsed"
            Width="52"
            Height="52"
            Padding="0"
            HorizontalAlignment="Center"
            Click="OnCompactClick"
            AutomationProperties.Name="任务面板"
            ToolTipService.ToolTip="{x:Bind ViewModel.StatusLabel, Mode=OneWay}"
            Style="{StaticResource SidebarIconButtonStyle}">
      <Grid Width="52" Height="52">
        <controls:GlassPanel Padding="0" CornerRadius="16" Blur="False" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
          <Ellipse Width="7" Height="7" Fill="{x:Bind helpers:Ui.StatusBrush(ViewModel.StatusKind), Mode=OneWay}" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Bind ViewModel.SavedCount, Mode=OneWay}"
                     FontFamily="{StaticResource NumberFontFamily}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{ThemeResource SidebarTextBrush}" />
        </StackPanel>
      </Grid>
      <Button.Flyout>
        <Flyout x:Name="CompactFlyout" Placement="RightEdgeAlignedTop" Opening="OnCompactFlyoutOpening" />
      </Button.Flyout>
    </Button>
  </Grid>
</UserControl>
