<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.ExtractionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource GlassCardStyle}">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource IceBlueSoftBrush}">
          <FontIcon Glyph="&#xE8A5;" Foreground="{StaticResource IceBlueBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel>
          <TextBlock Text="提取控制" Style="{StaticResource CardTitleStyle}" />
          <TextBlock Text="Extraction session" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="等待浏览器和 Worker 接入"
                 Style="{StaticResource SecondaryTextStyle}" />
      <ProgressBar Minimum="0" Maximum="100" Value="0" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="开始提取" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
        <Button Grid.Column="1" Content="暂停" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
      </Grid>
      <Button Content="停止并清空" Style="{StaticResource QuietButtonStyle}" IsEnabled="False" />
    </StackPanel>
  </Border>
</UserControl>
