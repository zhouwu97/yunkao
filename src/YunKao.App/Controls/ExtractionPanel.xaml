<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.ExtractionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <controls:LiquidCard Variant="Blue" Padding="15">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource IceBlueSoftBrush}">
          <FontIcon Glyph="&#xE8A5;" Foreground="{StaticResource IceBlueBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel>
          <TextBlock Text="提取任务" Style="{StaticResource CardTitleStyle}" />
          <TextBlock x:Name="StateText" Text="待机 · 等待进入练习页面" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="MutationObserver 驱动，稳定 100ms 后读取当前题。"
                 TextWrapping="Wrap"
                 Style="{StaticResource SecondaryTextStyle}" />
      <controls:LiquidButton x:Name="StartButton" Label="开始提取" Click="OnStartClick" Variant="Primary" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:LiquidButton x:Name="PauseButton" Grid.Column="0" Label="暂停" Click="OnPauseClick" Variant="Soft" IsEnabled="False" />
        <controls:LiquidButton x:Name="StopButton" Grid.Column="1" Label="停止" Click="OnStopClick" Variant="Coral" IsEnabled="False" />
      </Grid>
    </StackPanel>
  </controls:LiquidCard>
</UserControl>
