<?xml version="1.0" encoding="utf-8"?>
<!-- 常驻浏览器宿主：只有网页和错误提示，地址栏与导航按钮在侧边栏。 -->
<UserControl
    x:Class="YunKao.Controls.BrowserShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls"
    Loaded="OnLoaded">
  <Grid Background="{ThemeResource WebViewSurfaceBrush}">
    <wv2:WebView2 x:Name="WebView" SizeChanged="OnWebViewSurfaceSizeChanged" />
    <ProgressBar x:Name="LoadingProgress" IsIndeterminate="False" Visibility="Collapsed"
                 Height="3" MinHeight="3" VerticalAlignment="Top" IsHitTestVisible="False"
                 AutomationProperties.Name="正在加载网页" />

    <Grid x:Name="NavigationErrorOverlay" Background="{ThemeResource SurfaceBrush}" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440" Margin="32">
        <FontIcon Glyph="&#xE774;" FontSize="32" Foreground="{ThemeResource TextSecondaryBrush}" />
        <TextBlock Text="网页暂时无法打开" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="NavigationErrorText" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
        <TextBlock Text="请检查网络后重试。已保存的题目仍可在左侧导出。" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Content="重新加载" Click="OnReloadClick" Style="{StaticResource PrimaryButtonStyle}" />
          <Button Content="返回云考首页" Click="OnHomeClick" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid x:Name="WebViewErrorOverlay" Background="{ThemeResource SurfaceBrush}" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440" Margin="32">
        <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource DangerSoftBrush}" HorizontalAlignment="Center">
          <FontIcon Glyph="&#xE783;" FontSize="26" Foreground="{ThemeResource DangerTextBrush}" />
        </Border>
        <TextBlock x:Name="ErrorTitleText" Text="浏览器组件未就绪" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="ErrorMessageText"
                   Text="融智云考需要 Microsoft Edge WebView2 Runtime。"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button Content="安装 WebView2" Click="OnInstallWebView2Click" Style="{StaticResource PrimaryButtonStyle}" />
          <Button Content="重新检测" Click="OnRetryWebView2Click" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
