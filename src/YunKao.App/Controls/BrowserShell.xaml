<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.BrowserShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:YunKao.Controls"
    Loaded="OnLoaded">
  <Grid RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:LiquidCard Grid.Row="0" Padding="5">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Click="OnBackClick" ToolTipService.ToolTip="后退" Style="{StaticResource IconButtonStyle}">
          <FontIcon Glyph="&#xE72B;" />
        </Button>
        <Button Grid.Column="1" Click="OnRefreshClick" ToolTipService.ToolTip="刷新" Style="{StaticResource IconButtonStyle}">
          <FontIcon Glyph="&#xE72C;" />
        </Button>
        <Grid Grid.Column="2" ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource CyanPrimaryBrush}" VerticalAlignment="Center" />
          <Grid Grid.Column="1">
            <TextBlock x:Name="AddressDisplay"
                       Text="cctrcloud.net"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Tapped="OnAddressDisplayTapped"
                       ToolTipService.ToolTip="点击编辑 HTTPS 地址"
                       Style="{StaticResource SecondaryTextStyle}" />
            <TextBox x:Name="AddressBox"
                     Visibility="Collapsed"
                     PlaceholderText="输入 HTTPS 地址"
                     KeyDown="OnAddressKeyDown"
                     LostFocus="OnAddressLostFocus"
                     ToolTipService.ToolTip="完整地址"
                     Style="{StaticResource AddressBarStyle}" />
          </Grid>
        </Grid>
        <Button Grid.Column="3" Click="OnExternalClick" ToolTipService.ToolTip="在浏览器中打开" Style="{StaticResource IconButtonStyle}">
          <FontIcon Glyph="&#xE8A7;" />
        </Button>
      </Grid>
    </controls:LiquidCard>

    <Border Grid.Row="1"
            Background="{StaticResource ContentSurfaceBrush}"
            BorderBrush="{StaticResource LiquidInnerBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="1">
      <wv2:WebView2 x:Name="WebView" SizeChanged="OnWebViewSurfaceSizeChanged" />
    </Border>

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Text="正在准备 WebView2..."
               Style="{StaticResource CaptionTextStyle}"
               TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
