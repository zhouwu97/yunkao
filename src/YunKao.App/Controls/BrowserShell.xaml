<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.BrowserShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls"
    Loaded="OnLoaded">
  <Grid RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource ToolbarCardStyle}">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="‹" Click="OnBackClick" Style="{StaticResource IconButtonStyle}" />
        <Button Grid.Column="1" Content="↻" Click="OnRefreshClick" Style="{StaticResource IconButtonStyle}" />
        <TextBox x:Name="AddressBox"
                 Grid.Column="2"
                 Text="https://www.cctrcloud.net/"
                 PlaceholderText="输入 HTTPS 地址"
                 KeyDown="OnAddressKeyDown"
                 Style="{StaticResource AddressBarStyle}" />
        <Button Grid.Column="3" Content="↗" Click="OnExternalClick" Style="{StaticResource IconButtonStyle}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource WebViewSurfaceBrush}" CornerRadius="14">
      <wv2:WebView2 x:Name="WebView" />
    </Border>

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Text="正在准备 WebView2..."
               Style="{StaticResource CaptionTextStyle}"
               TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
