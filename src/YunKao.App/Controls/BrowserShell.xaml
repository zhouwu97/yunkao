<?xml version="1.0" encoding="utf-8"?>
<!-- 常驻浏览器宿主：只有网页和错误提示，地址栏与导航按钮位于工作台顶部。 -->
<UserControl
    x:Class="YunKao.Controls.BrowserShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls"
    Loaded="OnLoaded">
  <Grid x:Name="Viewport" SizeChanged="OnViewportSizeChanged">
    <Grid x:Name="WebContent"><wv2:WebView2 x:Name="WebView" SizeChanged="OnWebViewSurfaceSizeChanged" /></Grid>
    <ProgressBar x:Name="LoadingProgress" IsIndeterminate="False" Visibility="Collapsed"
                 Height="3" MinHeight="3" VerticalAlignment="Top" IsHitTestVisible="False"
                 AutomationProperties.Name="正在加载网页" />

    <Grid x:Name="NavigationErrorOverlay" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
          Background="Transparent" Margin="32,12" MaxWidth="425">
      <controls:LiquidGlassSurface x:Name="ErrorGlass" SurfaceCorners="23" Tint="{ThemeResource GlassTintBrush}" />
      <Border CornerRadius="24" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeBrush}"
              Opacity="{Binding FallbackOpacity, ElementName=ErrorGlass}" IsHitTestVisible="False" />
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="14" Margin="28">
        <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource WarningSoftBrush}" HorizontalAlignment="Left">
          <FontIcon Glyph="&#xE774;" FontSize="26" Foreground="{ThemeResource WarningTextBrush}" />
        </Border>
        <TextBlock Text="网页暂时无法打开" FontSize="23" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Left" />
        <TextBlock x:Name="NavigationErrorText" TextWrapping="Wrap" TextAlignment="Left" Style="{StaticResource SecondaryTextStyle}" />
        <TextBlock Text="请检查网络后重试。已保存的题目仍可在左侧导出。" TextWrapping="Wrap" TextAlignment="Left" Style="{StaticResource CaptionTextStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
          <Button x:Name="RetryNavigation" Content="重新加载" AutomationProperties.Name="重新加载" Click="OnReloadClick" Style="{StaticResource PrimaryButtonStyle}" />
          <Button Content="返回云考首页" AutomationProperties.Name="返回云考首页" Click="OnHomeClick" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid x:Name="WebViewErrorOverlay" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
          Background="Transparent" Margin="32,12" MaxWidth="425">
      <controls:LiquidGlassSurface x:Name="RuntimeGlass" SurfaceCorners="23" Tint="{ThemeResource GlassTintBrush}" />
      <Border CornerRadius="24" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeBrush}"
              Opacity="{Binding FallbackOpacity, ElementName=RuntimeGlass}" IsHitTestVisible="False" />
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="14" Margin="28">
        <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource DangerSoftBrush}" HorizontalAlignment="Left">
          <FontIcon Glyph="&#xE783;" FontSize="26" Foreground="{ThemeResource DangerTextBrush}" />
        </Border>
        <TextBlock x:Name="ErrorTitleText" Text="浏览器组件未就绪" FontSize="23" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Left" />
        <TextBlock x:Name="ErrorMessageText"
                   Text="融智云考需要 Microsoft Edge WebView2 Runtime。"
                   TextWrapping="Wrap"
                   TextAlignment="Left"
                   HorizontalAlignment="Left"
                   Style="{StaticResource SecondaryTextStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" Margin="0,6,0,0">
          <Button Content="安装 WebView2" Click="OnInstallWebView2Click" Style="{StaticResource PrimaryButtonStyle}" />
          <Button Content="重新检测" Click="OnRetryWebView2Click" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
