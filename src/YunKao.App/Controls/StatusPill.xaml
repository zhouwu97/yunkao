<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.StatusPill"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="Surface"
          Background="{StaticResource LiquidSurfaceStrongBrush}"
          BorderBrush="{StaticResource LiquidInnerBorderBrush}"
          BorderThickness="1"
          CornerRadius="18"
          Padding="9,5">
    <ContentPresenter Content="{Binding Content, ElementName=Root}"
                      Foreground="{Binding Foreground, ElementName=Root}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
  </Border>
</UserControl>
