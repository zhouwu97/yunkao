<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:YunKao.Helpers">
  <StackPanel Spacing="10" MaxWidth="380" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,8" Background="{ThemeResource SurfaceSubtleBrush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
      <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="22" Foreground="{ThemeResource TextSecondaryBrush}" />
    </Border>
    <TextBlock Text="{x:Bind Title, Mode=OneWay}" HorizontalAlignment="Center" FontSize="17" Style="{StaticResource SectionTitleStyle}" />
    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
               TextWrapping="Wrap"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               FontSize="13"
               LineHeight="20"
               Style="{StaticResource SecondaryTextStyle}" />
    <Button Content="{x:Bind ActionLabel, Mode=OneWay}"
            Visibility="{x:Bind helpers:Ui.HasText(ActionLabel), Mode=OneWay}"
            Click="OnActionClick"
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            Padding="18,8"
            Style="{StaticResource PrimaryButtonStyle}" />
  </StackPanel>
</UserControl>
