<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:YunKao.Helpers"
    xmlns:controls="using:YunKao.Controls">
  <controls:GlassPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="436" CornerRadius="20" Padding="26,23"
          TintScale="1.2" BorderBrush="{ThemeResource SurfaceStrokeBrush}">
    <StackPanel Spacing="9">
      <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,8" Background="{ThemeResource AccentSoftBrush}">
        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="26" Foreground="{ThemeResource TextAccentBrush}" />
      </Border>
      <TextBlock Text="{x:Bind Title, Mode=OneWay}" HorizontalAlignment="Center" FontSize="20" Style="{StaticResource SectionTitleStyle}" />
      <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 FontSize="13"
                 LineHeight="20"
                 Style="{StaticResource SecondaryTextStyle}" />
      <Button Content="{x:Bind ActionLabel, Mode=OneWay}"
              Visibility="{x:Bind helpers:Ui.HasText(ActionLabel), Mode=OneWay}"
              Click="OnActionClick"
              HorizontalAlignment="Center"
              Margin="0,10,0,0"
              Padding="18,8"
              Style="{StaticResource PrimaryButtonStyle}" />
    </StackPanel>
  </controls:GlassPanel>
</UserControl>
