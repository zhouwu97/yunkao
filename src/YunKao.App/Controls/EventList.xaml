<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.EventList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource GlassCardStyle}">
    <StackPanel Spacing="10">
      <Grid>
        <TextBlock Text="运行事件" Style="{StaticResource CardTitleStyle}" />
        <TextBlock Text="LIVE" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
      </Grid>
      <ListView IsItemClickEnabled="False" MaxHeight="150" BorderThickness="0" Background="Transparent">
        <ListViewItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" />
            <TextBlock Text="UI 骨架已加载" Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </ListViewItem>
        <ListViewItem>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
            <TextBlock Text="等待 WebView2 / Worker" Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </ListViewItem>
      </ListView>
    </StackPanel>
  </Border>
</UserControl>
