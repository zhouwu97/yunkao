<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:YunKao.Helpers">
  <Grid x:Name="HeaderGrid" ColumnSpacing="16" Padding="26,2,26,22" SizeChanged="OnHeaderSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel x:Name="HeaderText" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind helpers:Ui.HasText(Description), Mode=OneWay}"
                   Style="{StaticResource SecondaryTextStyle}"
                   FontSize="13" />
        <Grid Margin="0,4,0,0" Visibility="{x:Bind helpers:Ui.HasText(Status), Mode=OneWay}">
          <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                     TextWrapping="Wrap"
                     IsTextSelectionEnabled="True"
                     AutomationProperties.LiveSetting="Polite"
                     Style="{StaticResource CaptionTextStyle}" />
        </Grid>
    </StackPanel>
    <ContentPresenter x:Name="HeaderActions" Grid.Column="1" Content="{x:Bind Actions, Mode=OneWay}" VerticalAlignment="Top" Margin="0,4,0,0" />
  </Grid>
</UserControl>
