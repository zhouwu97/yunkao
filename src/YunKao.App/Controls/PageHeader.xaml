<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:YunKao.Helpers">
  <Grid ColumnSpacing="16" Padding="32,28,32,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="4" VerticalAlignment="Center">
      <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                 TextWrapping="Wrap"
                 Visibility="{x:Bind helpers:Ui.HasText(Description), Mode=OneWay}"
                 Style="{StaticResource SecondaryTextStyle}"
                 FontSize="13" />
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="{x:Bind helpers:Ui.HasText(Status), Mode=OneWay}">
        <Ellipse Width="6" Height="6" Fill="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Style="{StaticResource CaptionTextStyle}" />
      </StackPanel>
    </StackPanel>
    <ContentPresenter Grid.Column="1" Content="{x:Bind Actions, Mode=OneWay}" VerticalAlignment="Top" Margin="0,4,0,0" />
  </Grid>
</UserControl>
