<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.ProgressCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <controls:LiquidCard Variant="Blue" Padding="14">
    <StackPanel Spacing="8">
      <Grid>
        <TextBlock Text="提取进度" Style="{StaticResource CardTitleStyle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="3">
          <TextBlock x:Name="CurrentText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BlueDeepBrush}" />
          <TextBlock Text="/" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
          <TextBlock x:Name="TotalText" Text="0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
      </Grid>
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource BluePrimaryBrush}" Height="6" />
      <Grid ColumnSpacing="6" Margin="0,3,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="1">
          <TextBlock x:Name="SavedMetricText" Text="0" Foreground="{StaticResource BlueDeepBrush}" FontWeight="SemiBold" />
          <TextBlock Text="已保存" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock x:Name="AiMetricText" Text="0" Foreground="{StaticResource VioletPrimaryBrush}" FontWeight="SemiBold" />
          <TextBlock Text="AI 待补" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="1">
          <TextBlock x:Name="SpeedMetricText" Text="—" Foreground="{StaticResource CoralPrimaryBrush}" FontWeight="SemiBold" />
          <TextBlock Text="平均速度" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="ProgressText" Text="尚未开始" Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>
  </controls:LiquidCard>
</UserControl>
