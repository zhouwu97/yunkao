<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.LiquidButton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="42"
    Foreground="White">
  <Grid x:Name="VisualRoot" RenderTransformOrigin="0.5,0.5">
    <Border x:Name="Surface"
            Background="Transparent"
            BorderBrush="#52FFFFFF"
            BorderThickness="1"
            CornerRadius="11">
      <Grid>
        <SystemBackdropElement x:Name="SystemBackdropLayer"
                               CornerRadius="11"
                               Opacity="0.62"
                               Visibility="Collapsed">
          <SystemBackdropElement.SystemBackdrop>
            <DesktopAcrylicBackdrop />
          </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>
        <Border x:Name="CompositionBackdropLayer"
                CornerRadius="11"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        <Border x:Name="TintLayer" CornerRadius="10" IsHitTestVisible="False" Opacity="0.78" />
        <Border x:Name="InnerRim"
                Margin="1"
                CornerRadius="10"
                BorderThickness="1"
                IsHitTestVisible="False" />
        <Border x:Name="InteractiveHighlight"
                CornerRadius="10"
                Opacity="0"
                IsHitTestVisible="False">
          <Border.Background>
            <!-- 只沿最近的边缘展开，避免形成跟随鼠标的完整圆形光斑。 -->
            <LinearGradientBrush x:Name="SpecularBrush"
                                 StartPoint="0,0.5"
                                 EndPoint="0.82,0.5">
              <GradientStop Color="#B8FFFFFF" Offset="0" />
              <GradientStop Color="#48FFFFFF" Offset="0.28" />
              <GradientStop Color="#00FFFFFF" Offset="0.72" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Button x:Name="HitTarget"
                Background="Transparent"
                BorderThickness="0"
                Padding="{Binding Padding, ElementName=Root}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnClick"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerMoved="OnPointerMoved"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnPointerReleased"
                PointerCaptureLost="OnPointerCaptureLost">
          <TextBlock Text="{Binding Label, ElementName=Root}"
                     Foreground="{Binding Foreground, ElementName=Root}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
