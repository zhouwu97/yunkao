<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.LiquidButton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="42"
    Foreground="White">
  <Grid x:Name="VisualRoot" RenderTransformOrigin="0.5,0.5">
    <Border Margin="0,2,0,3"
            Background="{StaticResource LiquidShadowBrush}"
            CornerRadius="11"
            IsHitTestVisible="False" />
    <Border x:Name="Surface"
            Background="Transparent"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="11">
      <Grid>
        <SystemBackdropElement x:Name="BackdropLayer"
                               CornerRadius="11">
          <SystemBackdropElement.SystemBackdrop>
            <DesktopAcrylicBackdrop />
          </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>
        <Border x:Name="TintLayer" CornerRadius="10" IsHitTestVisible="False" Opacity="0.86" />
        <Border x:Name="InteractiveHighlight"
                CornerRadius="10"
                Background="#46FFFFFF"
                Opacity="0"
                IsHitTestVisible="False" />
        <Border Height="1"
                Margin="12,1,12,0"
                VerticalAlignment="Top"
                Background="#D6FFFFFF"
                CornerRadius="1"
                IsHitTestVisible="False" />
        <Button x:Name="HitTarget"
                Background="Transparent"
                BorderThickness="0"
                Padding="{Binding Padding, ElementName=Root}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnClick"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnPointerReleased"
                PointerCaptureLost="OnPointerCaptureLost">
          <TextBlock Text="{Binding Label, ElementName=Root}"
                     Foreground="{Binding Foreground, ElementName=Root}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
