<?xml version="1.0" encoding="utf-8"?>
<!-- 侧边栏顶部的浏览器控制：导航按钮 + 玻璃地址栏（展开）/ 竖排图标（紧凑）。 -->
<UserControl
    x:Class="YunKao.Controls.BrowserBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls"
    xmlns:helpers="using:YunKao.Helpers">
  <Grid>
    <!-- 展开 -->
    <StackPanel x:Name="ExpandedRoot" Spacing="6">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="0" Margin="-4,0,0,0">
          <Button Command="{x:Bind ViewModel.BackCommand}" AutomationProperties.Name="后退" ToolTipService.ToolTip="后退 (Alt+←)" Style="{StaticResource SidebarIconButtonStyle}">
            <FontIcon Glyph="&#xE72B;" FontSize="14" />
          </Button>
          <Button Command="{x:Bind ViewModel.ForwardCommand}" AutomationProperties.Name="前进" ToolTipService.ToolTip="前进 (Alt+→)" Style="{StaticResource SidebarIconButtonStyle}">
            <FontIcon Glyph="&#xE72A;" FontSize="14" />
          </Button>
          <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.Name="刷新页面" ToolTipService.ToolTip="刷新 (F5)" Style="{StaticResource SidebarIconButtonStyle}">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
          </Button>
          <Button Command="{x:Bind ViewModel.HomeCommand}" AutomationProperties.Name="云考首页" ToolTipService.ToolTip="云考首页" Style="{StaticResource SidebarIconButtonStyle}">
            <FontIcon Glyph="&#xE80F;" FontSize="14" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" Margin="0,0,-4,0">
          <Button Command="{x:Bind ViewModel.FitWidthCommand}"
                  AutomationProperties.Name="切换适应宽度"
                  ToolTipService.ToolTip="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                  Style="{StaticResource SidebarIconButtonStyle}">
            <FontIcon Glyph="&#xE9A6;" FontSize="14" />
          </Button>
          <Button Command="{x:Bind ViewModel.ExternalCommand}" AutomationProperties.Name="在系统浏览器中打开" ToolTipService.ToolTip="在系统浏览器中打开" Style="{StaticResource SidebarIconButtonStyle}">
            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
          </Button>
        </StackPanel>
      </Grid>

      <controls:GlassPanel Padding="11,0" CornerRadius="9" MinHeight="36" Blur="False">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center" />
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="AddressDisplay"
                  Background="Transparent"
                  Click="OnAddressClick" Padding="0" MinWidth="0" BorderThickness="0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="编辑网址 (Ctrl+L)"
                  Style="{StaticResource SubtleButtonStyle}"
                  ToolTipService.ToolTip="{x:Bind ViewModel.FullAddress, Mode=OneWay}">
              <TextBlock TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center">
                <Run Text="{x:Bind ViewModel.Host, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource SidebarTextBrush}" />
                <Run Text="{x:Bind ViewModel.Path, Mode=OneWay}" Foreground="{ThemeResource SidebarTextTertiaryBrush}" />
              </TextBlock>
            </Button>
            <TextBox x:Name="AddressBox"
                     AutomationProperties.Name="地址栏"
                     Visibility="Collapsed"
                     PlaceholderText="输入 HTTPS 地址"
                     KeyDown="OnAddressKeyDown"
                     LostFocus="OnAddressLostFocus"
                     Style="{StaticResource AddressBarStyle}" />
          </Grid>
        </Grid>
      </controls:GlassPanel>

      <TextBlock x:Name="AddressError" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                 Foreground="{ThemeResource DangerTextBrush}" AutomationProperties.LiveSetting="Polite" />

      <TextBlock x:Name="StatusLine"
                 Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 Margin="4,0"
                 FontSize="11"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource SidebarTextTertiaryBrush}"
                 ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <!-- 紧凑 -->
    <StackPanel x:Name="CompactRoot" Spacing="2" Visibility="Collapsed" HorizontalAlignment="Center">
      <Button x:Name="CompactAddressButton" AutomationProperties.Name="地址栏" ToolTipService.ToolTip="地址 (Ctrl+L)" Style="{StaticResource SidebarIconButtonStyle}" Width="40" Height="36">
        <FontIcon Glyph="&#xE71B;" FontSize="14" />
        <Button.Flyout>
          <Flyout x:Name="AddressFlyout" Placement="RightEdgeAlignedTop" Opened="OnAddressFlyoutOpened">
            <StackPanel Spacing="8" Width="360">
              <TextBlock Text="网址" Style="{StaticResource SmallLabelStyle}" />
              <TextBox x:Name="CompactAddressBox" PlaceholderText="输入 HTTPS 地址" KeyDown="OnCompactAddressKeyDown" />
              <TextBlock x:Name="CompactAddressError" Visibility="Collapsed" Foreground="{ThemeResource DangerTextBrush}" FontSize="12" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button Command="{x:Bind ViewModel.BackCommand}" AutomationProperties.Name="后退" ToolTipService.ToolTip="后退" Style="{StaticResource SidebarIconButtonStyle}" Width="40" Height="36">
        <FontIcon Glyph="&#xE72B;" FontSize="14" />
      </Button>
      <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.Name="刷新页面" ToolTipService.ToolTip="刷新" Style="{StaticResource SidebarIconButtonStyle}" Width="40" Height="36">
        <FontIcon Glyph="&#xE72C;" FontSize="14" />
      </Button>
      <Button AutomationProperties.Name="更多浏览器操作" ToolTipService.ToolTip="前进、首页、缩放与外部浏览器"
              Style="{StaticResource SidebarIconButtonStyle}" Width="40" Height="36">
        <FontIcon Glyph="&#xE712;" FontSize="14" />
        <Button.Flyout>
          <MenuFlyout Placement="RightEdgeAlignedTop">
            <MenuFlyoutItem Text="前进" Command="{x:Bind ViewModel.ForwardCommand}" />
            <MenuFlyoutItem Text="云考首页" Command="{x:Bind ViewModel.HomeCommand}" />
            <MenuFlyoutItem Text="切换适应宽度 / 原始大小" Command="{x:Bind ViewModel.FitWidthCommand}" />
            <MenuFlyoutItem Text="在系统浏览器中打开" Command="{x:Bind ViewModel.ExternalCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
