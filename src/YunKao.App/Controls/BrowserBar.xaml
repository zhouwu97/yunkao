<UserControl x:Class="YunKao.Controls.BrowserBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:YunKao.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12" SizeChanged="OnBarSizeChanged">
    <Grid Margin="8,0,8,0" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="练习工作台" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                 TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionTextStyle}" />
    </Grid>
    <Grid x:Name="ToolbarShell" Background="Transparent">
      <controls:LiquidGlassSurface x:Name="ToolbarGlass" SurfaceCorners="17" Tint="{ThemeResource GlassTintBrush}" />
      <Border CornerRadius="18" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1"
              Opacity="{Binding FallbackOpacity, ElementName=ToolbarGlass}" IsHitTestVisible="False" />
      <Grid Padding="9,6" ColumnSpacing="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="1">
        <Button Command="{x:Bind ViewModel.BackCommand}" AutomationProperties.Name="后退" ToolTipService.ToolTip="后退 (Alt+←)" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE72B;" FontSize="14" /></Button>
        <Button x:Name="ForwardButton" Command="{x:Bind ViewModel.ForwardCommand}" AutomationProperties.Name="前进" ToolTipService.ToolTip="前进 (Alt+→)" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE72A;" FontSize="14" /></Button>
        <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.Name="刷新页面" ToolTipService.ToolTip="刷新 (F5)" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
      </StackPanel>
      <Grid Grid.Column="1" Background="{ThemeResource AddressInsetBrush}" CornerRadius="10">
          <Button x:Name="AddressDisplay"
                  Click="OnAddressClick" Padding="11,0" MinWidth="0" MinHeight="36" CornerRadius="9"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="编辑网址 (Ctrl+L)"
                  Style="{StaticResource SubtleButtonStyle}"
                  ToolTipService.ToolTip="{x:Bind ViewModel.FullAddress, Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center">
                <Run Text="{x:Bind ViewModel.Host, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <Run Text="{x:Bind ViewModel.Path, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}" />
              </TextBlock>
            </Grid>
          </Button>
          <TextBox x:Name="AddressBox"
                   AutomationProperties.Name="地址栏"
                   Visibility="Collapsed"
                   Margin="4,0" VerticalAlignment="Center"
                   PlaceholderText="输入 HTTPS 地址"
                   KeyDown="OnAddressKeyDown"
                   LostFocus="OnAddressLostFocus"
                   Style="{StaticResource AddressBarStyle}" />

      </Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="ZoomButton" Command="{x:Bind ViewModel.FitWidthCommand}" AutomationProperties.Name="切换适应宽度"
                ToolTipService.ToolTip="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9A6;" FontSize="13" /><TextBlock Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}" FontSize="12" /></StackPanel>
        </Button>
        <Button AutomationProperties.Name="更多浏览器操作" ToolTipService.ToolTip="更多浏览器操作" Style="{StaticResource IconButtonStyle}">
          <FontIcon Glyph="&#xE712;" FontSize="15" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuFlyoutItem x:Name="ForwardMenu" Text="前进" Command="{x:Bind ViewModel.ForwardCommand}" />
              <MenuFlyoutItem Text="云考首页" Command="{x:Bind ViewModel.HomeCommand}" />
              <MenuFlyoutItem x:Name="ZoomMenu" Text="切换适应宽度 / 原始大小" Command="{x:Bind ViewModel.FitWidthCommand}" />
              <MenuFlyoutItem Text="在系统浏览器中打开" Command="{x:Bind ViewModel.ExternalCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>
    </Grid>
    <TextBlock x:Name="AddressError" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="10,0"
               Foreground="{ThemeResource DangerTextBrush}" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
