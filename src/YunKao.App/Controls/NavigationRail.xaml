<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.NavigationRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="8,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Width="32" Height="32" CornerRadius="11" Background="{StaticResource BluePrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24">
      <TextBlock Text="Y" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <Grid x:Name="NavigationArea"
          Grid.Row="1"
          SizeChanged="OnNavigationAreaSizeChanged">
      <Border x:Name="SelectionBlob"
              Width="44"
              Height="44"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Background="Transparent"
              IsHitTestVisible="False">
        <Border.RenderTransform>
          <TranslateTransform x:Name="SelectionTranslation" />
        </Border.RenderTransform>
        <Border x:Name="SelectionShape"
                Background="{StaticResource ActiveNavigationBrush}"
                BorderBrush="{StaticResource LiquidInnerBorderBrush}"
                BorderThickness="1"
                CornerRadius="15">
          <Border.RenderTransform>
            <ScaleTransform x:Name="SelectionScale" />
          </Border.RenderTransform>
        </Border>
      </Border>

      <StackPanel x:Name="NavigationItems" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button x:Name="WorkspaceButton"
              Click="OnWorkspaceClick"
              ToolTipService.ToolTip="工作台"
              Style="{StaticResource NavigationButtonStyle}">
        <FontIcon Glyph="&#xE80F;" FontSize="20" />
      </Button>
      <Button x:Name="HistoryButton"
              Click="OnHistoryClick"
              ToolTipService.ToolTip="历史记录"
              Style="{StaticResource NavigationButtonStyle}">
        <FontIcon Glyph="&#xE81C;" FontSize="20" />
      </Button>
      <Button x:Name="ExportButton"
              Click="OnExportClick"
              ToolTipService.ToolTip="导出记录"
              Style="{StaticResource NavigationButtonStyle}">
        <FontIcon Glyph="&#xE896;" FontSize="20" />
      </Button>
      <Button x:Name="DiagnosticsButton"
              Click="OnDiagnosticsClick"
              ToolTipService.ToolTip="诊断"
              Style="{StaticResource NavigationButtonStyle}">
        <FontIcon Glyph="&#xE9D9;" FontSize="20" />
      </Button>
      </StackPanel>
    </Grid>

    <Button x:Name="SettingsButton"
            Grid.Row="2"
            Click="OnSettingsClick"
            ToolTipService.ToolTip="设置"
            Style="{StaticResource NavigationButtonStyle}">
      <FontIcon Glyph="&#xE713;" FontSize="20" />
    </Button>
  </Grid>
</UserControl>
