<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.NavigationRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="12,16,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="4,0,4,24" Spacing="4">
      <TextBlock x:Name="HeaderLabel" Text="导航" Style="{StaticResource CaptionTextStyle}" />
      <TextBlock x:Name="BrandLabel" Text="YunKao" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock x:Name="SubtitleLabel" Text="专注题库工作流" Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="4">
      <Button x:Name="WorkspaceButton"
              Click="OnWorkspaceClick"
              Style="{StaticResource NavigationButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE80F;" FontSize="16" />
          <TextBlock x:Name="WorkspaceLabel" Text="工作台" />
        </StackPanel>
      </Button>
      <Button x:Name="HistoryButton"
              Click="OnHistoryClick"
              ToolTipService.ToolTip="历史记录"
              Style="{StaticResource NavigationButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE81C;" FontSize="16" />
          <TextBlock x:Name="HistoryLabel" Text="历史记录" />
        </StackPanel>
      </Button>
      <Button x:Name="ExportButton"
              Click="OnExportClick"
              ToolTipService.ToolTip="导出记录"
              Style="{StaticResource NavigationButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE896;" FontSize="16" />
          <TextBlock x:Name="ExportLabel" Text="导出记录" />
        </StackPanel>
      </Button>
      <Button x:Name="DiagnosticsButton"
              Click="OnDiagnosticsClick"
              ToolTipService.ToolTip="诊断"
              Style="{StaticResource NavigationButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE9D9;" FontSize="16" />
          <TextBlock x:Name="DiagnosticsLabel" Text="诊断" />
        </StackPanel>
      </Button>
      <Button x:Name="SettingsButton"
              Click="OnSettingsClick"
              ToolTipService.ToolTip="设置"
              Style="{StaticResource NavigationButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE713;" FontSize="16" />
          <TextBlock x:Name="SettingsLabel" Text="设置" />
        </StackPanel>
      </Button>
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource SubtleCardStyle}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" />
        <TextBlock x:Name="BaselineLabel" Text="迁移基准" Style="{StaticResource SmallLabelStyle}" />
        </StackPanel>
        <TextBlock x:Name="BaselineDescription" Text="PySide6 已验证功能保留为对照基线。"
                   TextWrapping="Wrap"
                   Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
