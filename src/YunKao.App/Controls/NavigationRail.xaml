<?xml version="1.0" encoding="utf-8"?>
<!--
  侧边导航：展开时为图标 + 名称的行，紧凑时显示图标和短名称。
  选中标记随当前页面移动，并遵循减少动画设置。
-->
<UserControl
    x:Class="YunKao.Controls.NavigationRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="GestureSurface" Background="Transparent" ManipulationMode="None">
    <Grid x:Name="SelectionBlob"
          Height="44"
          VerticalAlignment="Top"
          HorizontalAlignment="Stretch"
          IsHitTestVisible="False"
          RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <CompositeTransform x:Name="SelectionTransform" />
      </Grid.RenderTransform>
      <Border x:Name="LensFallback" CornerRadius="22" Background="{ThemeResource SidebarItemSelectedBrush}"
              BorderThickness="1" BorderBrush="{ThemeResource GlassRimBrush}" />
      <Grid x:Name="LensHost" Margin="-24" />
    </Grid>

    <StackPanel x:Name="NavigationItems" Spacing="5" SizeChanged="OnLayoutChanged">
      <Button x:Name="WorkspaceButton" Tag="Workspace" Click="OnItemClick" AutomationProperties.Name="工作台" ToolTipService.ToolTip="工作台" Style="{StaticResource SidebarNavItemStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE774;" FontSize="15" />
          <TextBlock Text="工作台" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="HistoryButton" Tag="History" Click="OnItemClick" AutomationProperties.Name="历史记录" ToolTipService.ToolTip="历史记录" Style="{StaticResource SidebarNavItemStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE81C;" FontSize="15" />
          <TextBlock Text="历史记录" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="ExportButton" Tag="Export" Click="OnItemClick" AutomationProperties.Name="导出记录" ToolTipService.ToolTip="导出记录" Style="{StaticResource SidebarNavItemStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE8B7;" FontSize="15" />
          <TextBlock Text="导出记录" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="DiagnosticsButton" Tag="Diagnostics" Click="OnItemClick" AutomationProperties.Name="诊断" ToolTipService.ToolTip="诊断" Style="{StaticResource SidebarNavItemStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE9D9;" FontSize="15" />
          <TextBlock Text="诊断" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="SettingsButton" Tag="Settings" Click="OnItemClick" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置" Style="{StaticResource SidebarNavItemStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE713;" FontSize="15" />
          <TextBlock Text="设置" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
