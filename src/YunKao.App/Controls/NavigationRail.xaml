<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.NavigationRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="12,16,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="4,0,4,24" Spacing="4">
      <TextBlock Text="导航" Style="{StaticResource CaptionTextStyle}" />
      <TextBlock Text="YunKao" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="专注题库工作流" Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="4">
      <Button x:Name="WorkspaceButton"
              Click="OnWorkspaceClick"
              Style="{StaticResource NavigationButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE80F;" FontSize="16" />
          <TextBlock Text="工作台" />
        </StackPanel>
      </Button>
      <Button x:Name="SettingsButton"
              Click="OnSettingsClick"
              Style="{StaticResource NavigationButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xE713;" FontSize="16" />
          <TextBlock Text="设置" />
        </StackPanel>
      </Button>
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource SubtleCardStyle}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" />
          <TextBlock Text="迁移基准" Style="{StaticResource SmallLabelStyle}" />
        </StackPanel>
        <TextBlock Text="PySide6 已验证功能保留为对照基线。"
                   TextWrapping="Wrap"
                   Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
