<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.LiquidCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="GlassRoot">
    <Border x:Name="ShadowLayer"
            Margin="0,2,0,4"
            Background="{StaticResource LiquidShadowBrush}"
            CornerRadius="18"
            IsHitTestVisible="False" />
    <Border x:Name="Surface"
            Background="Transparent"
            BorderBrush="{StaticResource LiquidBorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
      <Grid>
        <SystemBackdropElement x:Name="BackdropLayer"
                               CornerRadius="18">
          <SystemBackdropElement.SystemBackdrop>
            <DesktopAcrylicBackdrop />
          </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>
        <Border x:Name="TintLayer"
                CornerRadius="17"
                IsHitTestVisible="False"
                Opacity="0.52" />
        <Border Margin="1"
                CornerRadius="17"
                BorderBrush="{StaticResource LiquidInnerBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False" />
        <Border Height="1"
                Margin="16,1,16,0"
                VerticalAlignment="Top"
                Background="#E0FFFFFF"
                CornerRadius="1"
                IsHitTestVisible="False" />
        <ContentPresenter Margin="{Binding Padding, ElementName=Root}"
                          Content="{Binding Content, ElementName=Root}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
