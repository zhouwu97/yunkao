<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.LiquidCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="GlassRoot">
    <Border x:Name="Surface"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="18">
      <Grid>
        <SystemBackdropElement x:Name="SystemBackdropLayer"
                               CornerRadius="18"
                               Opacity="0.62"
                               Visibility="Collapsed">
          <SystemBackdropElement.SystemBackdrop>
          <DesktopAcrylicBackdrop />
          </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>
        <Border x:Name="CompositionBackdropLayer"
                CornerRadius="18"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        <Border x:Name="TintLayer"
                CornerRadius="17"
                IsHitTestVisible="False"
                Opacity="0.68" />
        <Border x:Name="OuterRim"
                CornerRadius="18"
                BorderThickness="1"
                IsHitTestVisible="False">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#86FFFFFF" Offset="0" />
              <GradientStop Color="#42FFFFFF" Offset="0.32" />
              <GradientStop Color="#18FFFFFF" Offset="0.72" />
              <GradientStop Color="#2AFFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.BorderBrush>
        </Border>
        <Border x:Name="InnerRim"
                Margin="1"
                CornerRadius="17"
                BorderThickness="1"
                IsHitTestVisible="False" />
        <ContentPresenter Margin="{Binding Padding, ElementName=Root}"
                          Content="{Binding Content, ElementName=Root}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
