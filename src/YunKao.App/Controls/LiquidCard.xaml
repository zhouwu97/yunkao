<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.LiquidCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border x:Name="ShadowLayer"
            Margin="0,2,0,4"
            Background="{StaticResource LiquidShadowBrush}"
            CornerRadius="16"
            IsHitTestVisible="False" />
    <Border x:Name="Surface"
            Background="{StaticResource LiquidSurfaceBrush}"
            BorderBrush="{StaticResource LiquidBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
      <Grid>
        <Border x:Name="TintLayer"
                CornerRadius="15"
                IsHitTestVisible="False"
                Opacity="0.72" />
        <Border Margin="1"
                CornerRadius="15"
                BorderBrush="{StaticResource LiquidInnerBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False" />
        <Border Height="1"
                Margin="14,1,14,0"
                VerticalAlignment="Top"
                Background="#CFFFFFFF"
                CornerRadius="1"
                IsHitTestVisible="False" />
        <ContentPresenter Margin="{Binding Padding, ElementName=Root}"
                          Content="{Binding Content, ElementName=Root}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
