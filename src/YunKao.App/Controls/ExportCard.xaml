<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.ExportCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <Border Background="#24EA8D7C"
          BorderBrush="#48FFFFFF"
          BorderThickness="1"
          CornerRadius="12"
          Padding="10">
    <StackPanel Spacing="10">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE74E;" FontSize="16" Foreground="{StaticResource CoralPrimaryBrush}" />
          <TextBlock Text="快捷导出" Style="{StaticResource CardTitleStyle}" />
        </StackPanel>
        <TextBlock x:Name="StateText" Text="READY" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
      </Grid>
      <ToggleSwitch x:Name="PracticeModeToggle"
                    Header="练习版"
                    OffContent="答案版"
                    OnContent="隐藏答案和解析"
                    Toggled="OnPracticeModeToggled" />
      <Grid ColumnSpacing="7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:LiquidButton x:Name="PdfButton" Grid.Column="0" Label="PDF" Variant="Soft" BackdropMode="Inherited" Click="OnPdfClick" />
        <controls:LiquidButton x:Name="DocxButton" Grid.Column="1" Label="DOCX" Variant="Violet" BackdropMode="Inherited" Click="OnDocxClick" />
        <Button x:Name="MoreButton"
                Grid.Column="2"
                Content="更多"
                Style="{StaticResource QuietButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Markdown" Tag="md" Click="OnMoreFormatClick" />
              <MenuFlyoutItem Text="TXT" Tag="txt" Click="OnMoreFormatClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
