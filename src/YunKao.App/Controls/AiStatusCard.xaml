<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.AiStatusCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">
  <controls:LiquidCard Variant="Violet" Padding="14">
    <StackPanel Spacing="8">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE945;" Foreground="{StaticResource VioletPrimaryBrush}" />
          <TextBlock Text="AI 辅助" Style="{StaticResource SmallLabelStyle}" />
        </StackPanel>
        <controls:StatusPill HorizontalAlignment="Right" Variant="Violet">
          <TextBlock x:Name="StatusText" Text="未启用" />
        </controls:StatusPill>
      </Grid>
      <TextBlock x:Name="DetailText" Text="缺少答案时自动补全 · 最大并发 3 · 可随时取消"
                 TextWrapping="Wrap"
                 Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>
  </controls:LiquidCard>
</UserControl>
