<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YunKao.Controls.AiStatusCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource SubtleCardStyle}">
    <StackPanel Spacing="8">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE945;" Foreground="{StaticResource LavenderBrush}" />
          <TextBlock Text="AI 辅助" Style="{StaticResource SmallLabelStyle}" />
        </StackPanel>
        <Border HorizontalAlignment="Right" Style="{StaticResource StatusPillStyle}">
          <TextBlock x:Name="StatusText" Text="未开始" />
        </Border>
      </Grid>
      <TextBlock x:Name="DetailText" Text="最多 3 个并发请求，随会话取消。"
                 TextWrapping="Wrap"
                 Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>
  </Border>
</UserControl>
