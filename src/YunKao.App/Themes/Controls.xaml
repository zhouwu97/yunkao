<?xml version="1.0" encoding="utf-8"?>
<!--
  控件样式（全部基于原生控件，保留键盘焦点、Command 和禁用态）：
    PrimaryButtonStyle         墨蓝实色主按钮
    SecondaryButtonStyle       内容区次按钮：可形变液态玻璃
    DangerButtonStyle          警示操作
    SubtleButtonStyle          文字按钮
    IconButtonStyle            图标按钮
    SidebarButtonStyle         外框上的半透明按钮（任务卡内）
    SidebarIconButtonStyle     外框上的图标按钮
    SegmentRadioStyle          分段选择（滑块式）
    RowItemStyle               分组列表行
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">

  <!-- 品牌按钮：实色填充 → 状态层 -->
  <ControlTemplate x:Key="AccentButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateOverlay.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateOverlay.Background" Value="#26000000" />
              <Setter Target="StateOverlay.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="RootGrid.Opacity" Value="0.42" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
      <Border x:Name="StateOverlay" Background="#1FFFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
      <ContentPresenter x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}"
                        FontWeight="{TemplateBinding FontWeight}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <!-- 普通按钮：填充 → 状态层 → 描边 -->
  <ControlTemplate x:Key="StandardButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid"
          Background="{TemplateBinding Background}"
          CornerRadius="{TemplateBinding CornerRadius}"
          RenderTransformOrigin="0.5,0.5">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateOverlay.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateOverlay.Background" Value="{ThemeResource ControlPressedOverlayBrush}" />
              <Setter Target="StateOverlay.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="RootGrid.Opacity" Value="0.42" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="StateOverlay" Background="{ThemeResource ControlHoverOverlayBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
      <ContentPresenter x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}"
                        FontWeight="{TemplateBinding FontWeight}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <!-- 原生按钮语义上的液态玻璃次操作。 -->
  <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid"
          Background="Transparent"
          RenderTransformOrigin="0.5,0.5">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters><Setter Target="ContentPresenter.Opacity" Value="0.9" /></VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters><Setter Target="ContentPresenter.Opacity" Value="0.78" /></VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="RootGrid.Opacity" Value="0.42" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <controls:LiquidGlassSurface x:Name="GlassSurface" Tint="{TemplateBinding Background}"
                    SolidBackground="{ThemeResource ControlFillBrush}"
                    SurfaceCorners="{TemplateBinding CornerRadius}"
                    BlurAmount="0.25" RefractionAmount="20" TintScale="0.65" />
      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="{Binding FallbackOpacity, ElementName=GlassSurface}" IsHitTestVisible="False" />
      <ContentPresenter x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}"
                        FontWeight="{TemplateBinding FontWeight}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <!-- 外框上的轻按钮：悬停是白色玻璃而不是灰色 -->
  <ControlTemplate x:Key="SidebarSubtleButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateOverlay.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateOverlay.Background" Value="{ThemeResource SidebarItemPressedBrush}" />
              <Setter Target="StateOverlay.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="RootGrid.Opacity" Value="0.38" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="StateOverlay" Background="{ThemeResource SidebarItemHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
      <ContentPresenter x:Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}"
                        FontWeight="{TemplateBinding FontWeight}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <Style x:Key="ButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadiusLarge}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Template" Value="{StaticResource AccentButtonTemplate}" />
    <Setter Property="Background" Value="{ThemeResource AccentFillBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource AccentRimBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
    <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Template" Value="{StaticResource StandardButtonTemplate}" />
    <Setter Property="Background" Value="{ThemeResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource DangerTextBrush}" />
  </Style>

  <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Template" Value="{StaticResource StandardButtonTemplate}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
    <Setter Property="Background" Value="{ThemeResource GlassInsetBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GlassInsetStrokeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource SidebarTextBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="SidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Template" Value="{StaticResource SidebarSubtleButtonTemplate}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource SidebarTextSecondaryBrush}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="SidebarGlassIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
    <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
  </Style>

  <!-- 导航只有移动玻璃透镜作为背景；原生按钮仍提供焦点、键盘与自动化。 -->
  <ControlTemplate x:Key="SidebarNavItemTemplate" TargetType="Button">
    <Grid x:Name="RootGrid" Background="Transparent">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver" />
          <VisualState x:Name="Pressed" />
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="RootGrid.Opacity" Value="0.38" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"
                        AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <!-- 侧边导航项（展开：图标 + 名称；紧凑：仅图标） -->
  <Style x:Key="SidebarNavItemStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Template" Value="{StaticResource SidebarNavItemTemplate}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource SidebarTextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="SidebarNavItemSelectedStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavItemStyle}">
    <Setter Property="Foreground" Value="{ThemeResource NavSelectedTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 分段选择：纸色轨道上的白色滑块 -->
  <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Thumb.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="Thumb" Opacity="0" IsHitTestVisible="False">
              <controls:LiquidGlassSurface Tint="{ThemeResource SegmentThumbBrush}"
                    SolidBackground="{ThemeResource SegmentThumbBrush}"
                    SurfaceCorners="{TemplateBinding CornerRadius}" BlurAmount="0.25" RefractionAmount="20" TintScale="0.65" />
              <Border BorderBrush="{ThemeResource SegmentThumbStrokeBrush}" BorderThickness="1"
                      CornerRadius="{TemplateBinding CornerRadius}" />
            </Grid>
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 分段控件的轨道容器 -->
  <Style x:Key="SegmentTrackStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SegmentTrackBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- 分组容器：内容卡片里的一组行 -->
  <Style x:Key="GroupStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style x:Key="RowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="AddressBarStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</ResourceDictionary>
