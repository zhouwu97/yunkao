<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="NavigationButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
  </Style>
  <Style x:Key="NavigationIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}" />
  <Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource BluePrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource IceBlueSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BlueDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidInnerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="13,8" />
  </Style>
  <Style x:Key="GhostButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidInnerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="13,8" />
  </Style>
  <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}" />
  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
    <Setter Property="Foreground" Value="{StaticResource CoralPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="#42EA8D7C" />
  </Style>
  <Style x:Key="AddressBarStyle" TargetType="TextBox">
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="#28F8FBFE" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="SelectionHighlightColor" Value="{StaticResource BluePrimaryBrush}" />
  </Style>
</ResourceDictionary>
