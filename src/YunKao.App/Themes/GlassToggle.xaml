<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:glass="using:YunKao.Controls">
  <Style x:Key="LiquidGlassToggleStyle" TargetType="glass:LiquidGlassToggleSwitch">
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="glass:LiquidGlassToggleSwitch">
          <Grid x:Name="PART_Track" Width="56" Height="44" Background="Transparent">
            <Border x:Name="PART_Fill" Height="30" CornerRadius="15" Background="#CFCBD3" />
            <Grid x:Name="PART_Thumb" Width="30" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left"
                  RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
              <Border x:Name="PART_Solid" CornerRadius="12" Background="White" />
              <Grid x:Name="PART_Glass" Margin="-10" Opacity="0" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="glass:LiquidGlassToggleSwitch" BasedOn="{StaticResource LiquidGlassToggleStyle}" />
</ResourceDictionary>
