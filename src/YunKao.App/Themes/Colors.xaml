<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="IceBlueColor">#6EA8FF</Color>
  <Color x:Key="LavenderColor">#8B7EE8</Color>
  <Color x:Key="CoralColor">#E8897C</Color>
  <Color x:Key="AmberColor">#DDA84F</Color>
  <Color x:Key="PinkMistColor">#D98FB5</Color>
  <Color x:Key="CyanColor">#65B8DD</Color>

  <SolidColorBrush x:Key="IceBlueBrush" Color="{StaticResource IceBlueColor}" />
  <SolidColorBrush x:Key="IceBlueSoftBrush" Color="#316EA8FF" />
  <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource LavenderColor}" />
  <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="PinkMistBrush" Color="{StaticResource PinkMistColor}" />
  <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="Transparent" />
  <SolidColorBrush x:Key="SolidWindowBackgroundBrush" Color="#EAF1F8" />
  <SolidColorBrush x:Key="TitleBarBrush" Color="#C9DEF1" Opacity="0.58" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#C8EFF6FC" />
  <SolidColorBrush x:Key="WebViewSurfaceBrush" Color="#FBFDFF" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2B3A" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#65788B" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8EA0B0" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FFFFFF" Opacity="0.78" />
  <SolidColorBrush x:Key="ActiveNavigationBrush" Color="#5F9BF0" Opacity="0.18" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <SolidColorBrush x:Key="NoticeBrush" Color="#FFF4E1" Opacity="0.82" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DDF4F5" />
</ResourceDictionary>
