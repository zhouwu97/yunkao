<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- PR 1.5 palette: blue is the working color; violet, coral and amber are small accents. -->
  <Color x:Key="BluePrimary">#6C9FFF</Color>
  <Color x:Key="BlueBright">#8DBBFF</Color>
  <Color x:Key="BlueDeep">#4E78C8</Color>
  <Color x:Key="VioletPrimary">#8C7BE8</Color>
  <Color x:Key="CoralPrimary">#EA8D7C</Color>
  <Color x:Key="AmberPrimary">#D8A451</Color>
  <Color x:Key="CyanPrimary">#62B7D8</Color>
  <Color x:Key="PinkPrimary">#D792B7</Color>

  <!-- Compatibility aliases used by the existing extraction and history views. -->
  <Color x:Key="IceBlueColor">{StaticResource BluePrimary}</Color>
  <Color x:Key="LavenderColor">{StaticResource VioletPrimary}</Color>
  <Color x:Key="CoralColor">{StaticResource CoralPrimary}</Color>
  <Color x:Key="AmberColor">{StaticResource AmberPrimary}</Color>
  <Color x:Key="PinkMistColor">{StaticResource PinkPrimary}</Color>
  <Color x:Key="CyanColor">{StaticResource CyanPrimary}</Color>

  <Color x:Key="TextPrimary">#203145</Color>
  <Color x:Key="TextSecondary">#65798E</Color>
  <Color x:Key="TextTertiary">#91A0B0</Color>

  <SolidColorBrush x:Key="BluePrimaryBrush" Color="{StaticResource BluePrimary}" />
  <SolidColorBrush x:Key="BlueBrightBrush" Color="{StaticResource BlueBright}" />
  <SolidColorBrush x:Key="BlueDeepBrush" Color="{StaticResource BlueDeep}" />
  <SolidColorBrush x:Key="VioletPrimaryBrush" Color="{StaticResource VioletPrimary}" />
  <SolidColorBrush x:Key="CoralPrimaryBrush" Color="{StaticResource CoralPrimary}" />
  <SolidColorBrush x:Key="AmberPrimaryBrush" Color="{StaticResource AmberPrimary}" />
  <SolidColorBrush x:Key="CyanPrimaryBrush" Color="{StaticResource CyanPrimary}" />

  <SolidColorBrush x:Key="IceBlueBrush" Color="{StaticResource BluePrimary}" />
  <SolidColorBrush x:Key="IceBlueSoftBrush" Color="#2E6C9FFF" />
  <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource VioletPrimary}" />
  <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralPrimary}" />
  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberPrimary}" />
  <SolidColorBrush x:Key="PinkMistBrush" Color="{StaticResource PinkPrimary}" />
  <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanPrimary}" />

  <!-- Level 0: the window material is owned by BackdropService. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="Transparent" />
  <SolidColorBrush x:Key="SolidWindowBackgroundBrush" Color="#EEF2F6" />
  <SolidColorBrush x:Key="TitleBarBrush" Color="#38F0F7FC" />

  <!-- Level 1: clean, calm Fluent surfaces. -->
  <SolidColorBrush x:Key="LiquidSurfaceBrush" Color="#78F8FBFE" />
  <SolidColorBrush x:Key="LiquidSurfaceStrongBrush" Color="#A6FBFDFF" />
  <SolidColorBrush x:Key="LiquidSurfaceSubtleBrush" Color="#70F2F9FD" />
  <SolidColorBrush x:Key="LiquidSurfaceSoftBrush" Color="#88F0F9FE" />
  <SolidColorBrush x:Key="LiquidBorderBrush" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="LiquidInnerBorderBrush" Color="#48FFFFFF" />
  <SolidColorBrush x:Key="LiquidShadowBrush" Color="#120F2D58" />
  <SolidColorBrush x:Key="RailSurfaceBrush" Color="#94F9FCFF" />
  <SolidColorBrush x:Key="DrawerSurfaceBrush" Color="#C2F8FCFE" />
  <SolidColorBrush x:Key="DrawerBorderBrush" Color="#8AFFFFFF" />

  <!-- Level 2: content remains opaque and readable. -->
  <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#FAFBFD" />
  <SolidColorBrush x:Key="WebViewSurfaceBrush" Color="#FFFFFF" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LiquidBorderBrush}" />
  <SolidColorBrush x:Key="ActiveNavigationBrush" Color="#4E78C8" Opacity="0.16" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <SolidColorBrush x:Key="NoticeBrush" Color="#FFFBEB" Opacity="0.92" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#92400E" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="#991B1B" />

  <!-- Legacy name kept for controls that have not yet moved to LiquidCard. -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource LiquidSurfaceBrush}" />
</ResourceDictionary>
