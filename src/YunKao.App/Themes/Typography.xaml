<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 中文正文 Microsoft YaHei UI；数值 Segoe UI Variable。字号：标题 28 / 分组 17 / 正文 14 / 说明 12。 -->
  <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="NumberFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>

  <!-- 隐式样式只设字体，不设前景色，避免覆盖按钮等模板内继承的文字颜色。 -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
  </Style>

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="CardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="TitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}" />
  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
  </Style>
  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
  </Style>
  <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
  </Style>
  <Style x:Key="MetricTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumberFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="40" />
    <Setter Property="Foreground" Value="{ThemeResource SidebarTextTertiaryBrush}" />
  </Style>
  <Style x:Key="DisplayNumberStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumberFontFamily}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource SidebarTextBrush}" />
  </Style>
</ResourceDictionary>
