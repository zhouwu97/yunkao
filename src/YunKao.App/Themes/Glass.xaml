<?xml version="1.0" encoding="utf-8"?>
<!--
  外框上的卡片（任务卡、地址栏、折叠任务按钮）。纸感方向下为实体白卡 + 细线：
  关闭模糊，着色层完全不透明，高光画刷为透明。控件仍保留材质能力，换回玻璃风格时只需改这里与令牌。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">

  <Style x:Key="GlassPanelBaseStyle" TargetType="controls:GlassPanel">
    <Setter Property="Background" Value="{ThemeResource GlassTintBrush}" />
    <Setter Property="SolidBackground" Value="{ThemeResource GlassSolidBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GlassRimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource GlassCornerRadius}" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Blur" Value="False" />
    <Setter Property="ShowSheen" Value="False" />
    <Setter Property="TintScale" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:GlassPanel">
          <Grid>
            <Border x:Name="PART_Backdrop" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <Border x:Name="PART_Solid"
                    Background="{TemplateBinding SolidBackground}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <Border x:Name="PART_Tint"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False" />
            <Border x:Name="PART_Sheen"
                    Background="{ThemeResource GlassSheenBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False" />
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:GlassPanel" BasedOn="{StaticResource GlassPanelBaseStyle}" />
</ResourceDictionary>
