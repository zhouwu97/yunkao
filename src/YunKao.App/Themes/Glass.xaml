<?xml version="1.0" encoding="utf-8"?>
<!-- 共享液态玻璃：采样、磨砂、边缘折射、方向性高光与实体降级。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="GlassToggle.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="GlassPanelBaseStyle" TargetType="controls:GlassPanel">
    <Setter Property="Background" Value="{ThemeResource GlassTintBrush}" />
    <Setter Property="SolidBackground" Value="{ThemeResource GlassSolidBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GlassRimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource GlassCornerRadius}" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Blur" Value="True" />
    <Setter Property="ShowSheen" Value="True" />
    <Setter Property="BlurAmount" Value="0.25" />
    <Setter Property="TintScale" Value="0.65" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:GlassPanel">
          <Grid Background="Transparent">
            <controls:LiquidGlassSurface x:Name="PART_Surface"
                    Tint="{TemplateBinding Background}"
                    SolidBackground="{TemplateBinding SolidBackground}"
                    BackdropSource="{TemplateBinding BackdropSource}"
                    SurfaceCorners="{TemplateBinding CornerRadius}"
                    Blur="{TemplateBinding Blur}"
                    BlurAmount="{TemplateBinding BlurAmount}"
                    RefractionAmount="{TemplateBinding RefractionAmount}"
                    Saturation="{TemplateBinding Saturation}"
                    Dispersion="{TemplateBinding Dispersion}"
                    TintScale="{TemplateBinding TintScale}"
                    ShowSheen="{TemplateBinding ShowSheen}" />
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    Opacity="{Binding FallbackOpacity, ElementName=PART_Surface}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:GlassPanel" BasedOn="{StaticResource GlassPanelBaseStyle}" />

  <Style x:Key="GlassGroupStyle" TargetType="controls:GlassPanel" BasedOn="{StaticResource GlassPanelBaseStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="TintScale" Value="0.65" />
    <Setter Property="RefractionAmount" Value="28" />
  </Style>
</ResourceDictionary>
