      <SolidColorBrush x:Key="GlassInsetBrush" Color="#344B455D" />
      <SolidColorBrush x:Key="GlassInsetStrokeBrush" Color="#507F7693" />

      <SolidColorBrush x:Key="SurfaceBrush" Color="#262332" />
