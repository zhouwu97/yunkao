<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌（"纸感极简"方向）：
    暖白纸面、黑色文字、细线分隔；没有渐变、阴影、模糊和高光。
    蓝色只用于主操作、选中状态和链接。
  键名沿用：Frame* 外框 / Sidebar* 侧边栏 / Glass* 外框上的卡片（现为实体纸卡）/ Surface* 内容区 /
            Text* 文字 / Control* 控件 / Segment* 分段控件 / Accent* 品牌蓝 / Status* 状态点。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 墨蓝覆盖系统强调色，原生控件（开关、进度条、复选框、焦点）自动跟随。 -->
  <Color x:Key="SystemAccentColor">#2F5BD8</Color>
  <Color x:Key="SystemAccentColorLight1">#4A73E2</Color>
  <Color x:Key="SystemAccentColorLight2">#7C9BEB</Color>
  <Color x:Key="SystemAccentColorLight3">#B3C5F4</Color>
  <Color x:Key="SystemAccentColorDark1">#264CB8</Color>
  <Color x:Key="SystemAccentColorDark2">#1E3D95</Color>
  <Color x:Key="SystemAccentColorDark3">#162E70</Color>

  <SolidColorBrush x:Key="StatusReadyBrush" Color="#3E8E7E" />
  <SolidColorBrush x:Key="StatusRunningBrush" Color="#2F5BD8" />
  <SolidColorBrush x:Key="StatusPausedBrush" Color="#C98A1B" />
  <SolidColorBrush x:Key="StatusAiBrush" Color="#7A5AC8" />
  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#2E8A57" />
  <SolidColorBrush x:Key="StatusErrorBrush" Color="#C8473D" />
  <SolidColorBrush x:Key="StatusIdleBrush" Color="#A3A09A" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#1F1E1B" />

  <CornerRadius x:Key="ContentCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="GlassCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadiusLarge">7</CornerRadius>

  <ResourceDictionary.ThemeDictionaries>
    <!-- ==================== 浅色：暖白纸面 ==================== -->
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="FrameGradientBrush" Color="#F6F5F2" />
      <SolidColorBrush x:Key="FrameGlowPrimaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="FrameGlowSecondaryBrush" Color="Transparent" />

      <SolidColorBrush x:Key="SidebarTextBrush" Color="#1F1E1B" />
      <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#5F5D57" />
      <SolidColorBrush x:Key="SidebarTextTertiaryBrush" Color="#8C8A83" />
      <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#EDEBE6" />
      <SolidColorBrush x:Key="SidebarItemPressedBrush" Color="#E5E2DB" />
      <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#E9E7E1" />
      <SolidColorBrush x:Key="SidebarDividerBrush" Color="#E6E4DE" />

      <SolidColorBrush x:Key="GlassTintBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GlassSolidBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GlassRimBrush" Color="#E6E4DE" />
      <SolidColorBrush x:Key="GlassSheenBrush" Color="Transparent" />
      <SolidColorBrush x:Key="GlassInsetBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GlassInsetStrokeBrush" Color="#E0DDD6" />

      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F6F5F2" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#E6E4DE" />
      <SolidColorBrush x:Key="DividerBrush" Color="#EFEDE8" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="#F6F5F2" />
      <SolidColorBrush x:Key="WebViewSurfaceBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1E1B" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5D57" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8C8A83" />
      <SolidColorBrush x:Key="TextAccentBrush" Color="#2F5BD8" />

      <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ControlStrokeBrush" Color="#DEDBD3" />
      <SolidColorBrush x:Key="ControlHoverOverlayBrush" Color="#0A1F1E1B" />
      <SolidColorBrush x:Key="ControlPressedOverlayBrush" Color="#141F1E1B" />
      <SolidColorBrush x:Key="ControlSubtleHoverBrush" Color="#0D1F1E1B" />
      <SolidColorBrush x:Key="ControlSubtlePressedBrush" Color="#161F1E1B" />
      <SolidColorBrush x:Key="SegmentTrackBrush" Color="#EFEDE8" />
      <SolidColorBrush x:Key="SegmentThumbBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SegmentThumbStrokeBrush" Color="#DEDBD3" />

      <SolidColorBrush x:Key="AccentFillBrush" Color="#2F5BD8" />
      <SolidColorBrush x:Key="AccentRimBrush" Color="Transparent" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECF0FB" />

      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F3EC" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#FAF1DE" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBEBE9" />
      <SolidColorBrush x:Key="SuccessTextBrush" Color="#256E47" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5D0E" />
      <SolidColorBrush x:Key="DangerTextBrush" Color="#A93A31" />
    </ResourceDictionary>

    <!-- ==================== 深色：暖炭纸面 ==================== -->
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="FrameGradientBrush" Color="#191918" />
      <SolidColorBrush x:Key="FrameGlowPrimaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="FrameGlowSecondaryBrush" Color="Transparent" />

      <SolidColorBrush x:Key="SidebarTextBrush" Color="#ECEAE6" />
      <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#A8A59F" />
      <SolidColorBrush x:Key="SidebarTextTertiaryBrush" Color="#7E7B75" />
      <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#242422" />
      <SolidColorBrush x:Key="SidebarItemPressedBrush" Color="#2A2A28" />
      <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#2A2A28" />
      <SolidColorBrush x:Key="SidebarDividerBrush" Color="#2E2D2B" />

      <SolidColorBrush x:Key="GlassTintBrush" Color="#212120" />
      <SolidColorBrush x:Key="GlassSolidBrush" Color="#212120" />
      <SolidColorBrush x:Key="GlassRimBrush" Color="#31302E" />
      <SolidColorBrush x:Key="GlassSheenBrush" Color="Transparent" />
      <SolidColorBrush x:Key="GlassInsetBrush" Color="#2A2A28" />
      <SolidColorBrush x:Key="GlassInsetStrokeBrush" Color="#383734" />

      <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#262625" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#232322" />
      <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#31302E" />
      <SolidColorBrush x:Key="DividerBrush" Color="#2B2A28" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="#282826" />
      <SolidColorBrush x:Key="WebViewSurfaceBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEAE6" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8A59F" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7E7B75" />
      <SolidColorBrush x:Key="TextAccentBrush" Color="#8EAAF5" />

      <SolidColorBrush x:Key="ControlFillBrush" Color="#2A2A28" />
      <SolidColorBrush x:Key="ControlStrokeBrush" Color="#3A3936" />
      <SolidColorBrush x:Key="ControlHoverOverlayBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="ControlPressedOverlayBrush" Color="#1F000000" />
      <SolidColorBrush x:Key="ControlSubtleHoverBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="ControlSubtlePressedBrush" Color="#08FFFFFF" />
      <SolidColorBrush x:Key="SegmentTrackBrush" Color="#2A2A28" />
      <SolidColorBrush x:Key="SegmentThumbBrush" Color="#3A3936" />
      <SolidColorBrush x:Key="SegmentThumbStrokeBrush" Color="#45443F" />

      <SolidColorBrush x:Key="AccentFillBrush" Color="#3D69DE" />
      <SolidColorBrush x:Key="AccentRimBrush" Color="Transparent" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#25304A" />

      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F3328" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2F1A" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#3D2421" />
      <SolidColorBrush x:Key="SuccessTextBrush" Color="#7FCB9C" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#E7BE6C" />
      <SolidColorBrush x:Key="DangerTextBrush" Color="#F0958B" />
    </ResourceDictionary>

    <!-- ==================== 高对比度 ==================== -->
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="FrameGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="FrameGlowPrimaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="FrameGlowSecondaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="SidebarTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SidebarTextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SidebarItemPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SidebarDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GlassTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GlassSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GlassRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GlassSheenBrush" Color="Transparent" />
      <SolidColorBrush x:Key="GlassInsetBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GlassInsetStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="WebViewSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="TextAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ControlFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="ControlStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
      <SolidColorBrush x:Key="ControlHoverOverlayBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ControlPressedOverlayBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ControlSubtleHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ControlSubtlePressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SegmentTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SegmentThumbBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SegmentThumbStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AccentRimBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SuccessTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DangerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
