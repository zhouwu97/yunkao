      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#544574" />
      <SolidColorBrush x:Key="FrameGradientBrush" Color="#F7F4F6" />
      <SolidColorBrush x:Key="FrameGlowPrimaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="FrameGlowSecondaryBrush" Color="Transparent" />

      <SolidColorBrush x:Key="SidebarTextBrush" Color="#292638" />
      <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#504C61" />
      <SolidColorBrush x:Key="SidebarTextTertiaryBrush" Color="#625B70" />
      <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#EFECF6" />
      <SolidColorBrush x:Key="SidebarItemPressedBrush" Color="#E9E3F1" />
