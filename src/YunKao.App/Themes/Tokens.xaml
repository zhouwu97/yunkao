    <!-- ==================== 高对比度 ==================== -->
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="AddressInsetBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="PaperBandBrush" Color="Transparent" />
      <SolidColorBrush x:Key="PaperWarmBrush" Color="Transparent" />
      <SolidColorBrush x:Key="PaperLineBrush" Color="Transparent" />
      <SolidColorBrush x:Key="PaperSunBrush" Color="Transparent" />
