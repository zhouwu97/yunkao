<?xml version="1.0" encoding="utf-8"?>
<!-- 樱小路露娜主题。银紫、暖象牙和墨色服饰对应纸面、强调色与侧栏。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 墨蓝覆盖系统强调色，原生控件（开关、进度条、复选框、焦点）自动跟随。 -->
  <Color x:Key="SystemAccentColor">#62518B</Color>
  <Color x:Key="SystemAccentColorLight1">#8471AD</Color>
  <Color x:Key="SystemAccentColorLight2">#AA99C7</Color>
  <Color x:Key="SystemAccentColorLight3">#D8CDE9</Color>
  <Color x:Key="SystemAccentColorDark1">#504071</Color>
  <Color x:Key="SystemAccentColorDark2">#41345D</Color>
  <Color x:Key="SystemAccentColorDark3">#302643</Color>

  <SolidColorBrush x:Key="StatusReadyBrush" Color="#3E8E7E" />
  <SolidColorBrush x:Key="StatusRunningBrush" Color="#62518B" />
  <SolidColorBrush x:Key="StatusPausedBrush" Color="#C98A1B" />
  <SolidColorBrush x:Key="StatusAiBrush" Color="#7A5AC8" />
  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#2E8A57" />
  <SolidColorBrush x:Key="StatusErrorBrush" Color="#C8473D" />
  <SolidColorBrush x:Key="StatusIdleBrush" Color="#A3A09A" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#292638" />

  <CornerRadius x:Key="ContentCornerRadius">14</CornerRadius>
  <CornerRadius x:Key="GlassCornerRadius">16</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadiusLarge">7</CornerRadius>

  <ResourceDictionary.ThemeDictionaries>
