      <SolidColorBrush x:Key="GlassSheenBrush" Color="Transparent" />
      <SolidColorBrush x:Key="GlassInsetBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GlassInsetStrokeBrush" Color="#D2DCE9" />

      <SolidColorBrush x:Key="SurfaceBrush" Color="#F8F5F8" />
      <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F7F4F6" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#EEFFFFFF" />
