<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YunKao.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YunKao.Controls"
    Title="融智云考">
  <Grid x:Name="RootSurface" KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Default">
            <!-- Define the surface in the parent scope so it is available during InfoBar construction. -->
            <AcrylicBrush x:Key="ShellBannerBackground" TintColor="#343247" TintOpacity="0.94"
                          TintLuminosityOpacity="0.96" FallbackColor="#343247" />
            <SolidColorBrush x:Key="ShellBannerBorderBrush" Color="#656176" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellBannerBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellBannerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="FrameTint" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{ThemeResource FrameGradientBrush}" IsHitTestVisible="False" />
    <Grid x:Name="PaperArtwork" Background="{ThemeResource FrameGradientBrush}" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
      <Viewbox Stretch="Fill">
        <Canvas Width="1280" Height="800">
          <Path Fill="{ThemeResource PaperBandBrush}" Data="M 570,800 L 1030,0 L 1280,0 L 1280,800 Z" />
          <Path Fill="{ThemeResource PaperWarmBrush}" Data="M 915,800 L 1280,115 L 1280,800 Z" />
          <Path Fill="{ThemeResource PaperSunBrush}" Opacity=".36" Data="M 250,680 C 567,653 795,380 994,277 C 1118,208 1195,198 1280,210 L 1280,237 C 1008,204 833,478 598,614 C 445,704 315,719 250,724 Z" />
          <Path Stroke="{ThemeResource PaperLineBrush}" StrokeThickness="1" Data="M 205,687 C 651,682 829,254 1280,185 M 219,700 C 658,686 863,263 1280,194" />
          <Path Stroke="{ThemeResource PaperLineBrush}" StrokeThickness="1.3" Data="M 527,800 L 995,0 M 1246,0 L 794,800" />
        </Canvas>
      </Viewbox>
      <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="275" Height="455">
        <Ellipse Canvas.Left="12" Canvas.Top="18" Width="344" Height="344" Fill="{ThemeResource PaperSunBrush}" />
        <Ellipse Canvas.Left="0" Canvas.Top="6" Width="368" Height="368" Stroke="{ThemeResource PaperLineBrush}" />
        <Ellipse Canvas.Left="-15" Canvas.Top="-9" Width="398" Height="398" Stroke="{ThemeResource PaperLineBrush}" StrokeDashArray="2,7" />
      </Canvas>
      <Grid x:Name="PagePortrait" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Width="245" Height="350" Visibility="Collapsed" IsHitTestVisible="False">
        <Canvas><Image x:Name="PagePortraitArt" Source="ms-appx:///Assets/Luna.png" Width="245" ImageOpened="OnPortraitAvailable" /></Canvas>
      </Grid>
    </Grid>

    <Grid x:Name="RailScene" Grid.RowSpan="2" Margin="8,8,0,8" CornerRadius="19" RequestedTheme="Dark"
          Background="{ThemeResource RailBaseBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
      <Viewbox x:Name="RailArtwork" Stretch="Fill">
        <Canvas Width="250" Height="730">
          <Canvas.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#20253F" Offset="0"/><GradientStop Color="#38365F" Offset=".46"/>
              <GradientStop Color="#63567B" Offset=".72"/><GradientStop Color="#34374F" Offset="1"/>
            </LinearGradientBrush>
          </Canvas.Background>
          <Path Fill="#213B4782" Data="M 0,178 L 106,0 L 189,0 L 0,321 Z" />
          <Path Fill="#267E92C6" Data="M 0,466 L 250,70 L 250,198 L 0,596 Z" />
          <Path Stroke="#438C93CB" StrokeThickness="1.1" Data="M 0,402 L 250,5 M 0,451 L 250,54" />
          <Ellipse Width="294" Height="294" Canvas.Left="38" Canvas.Top="321" Fill="#349C8CB5" />
          <Ellipse Width="314" Height="314" Canvas.Left="28" Canvas.Top="311" Stroke="#60D8B5BA" StrokeThickness="1.1" />
          <Ellipse Width="326" Height="326" Canvas.Left="22" Canvas.Top="305" Stroke="#49E5B7BC" StrokeDashArray="2,7" />
        </Canvas>
      </Viewbox>
      <Canvas x:Name="RailPortraitCanvas" Width="165" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Image x:Name="RailPortraitArt" Source="ms-appx:///Assets/Luna.png" Stretch="Uniform"
               Width="{Binding Width, ElementName=RailPortraitCanvas}" ImageOpened="OnRailPortraitAvailable" />
      </Canvas>
    </Grid>

    <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent" Padding="24,8,140,0">
      <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center" RequestedTheme="Dark">
        <Border Width="33" Height="33" CornerRadius="11" Background="{ThemeResource BrandMarkBrush}">
          <Path Width="21" Height="19" Stretch="Uniform" Fill="{ThemeResource BrandInkBrush}"
                Data="M 1,4 L 8,6 Q 10,7 10,9 L 10,18 Q 8,16 6,16 L 1,14 Z M 12,7 Q 14,5 17,4 L 22,2 L 22,13 L 17,15 Q 14,16 12,18 Z" />
        </Border>
        <TextBlock x:Name="BrandText" Text="融智云考" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SidebarTextBrush}" />
      </StackPanel>
    </Grid>

    <ScrollViewer x:Name="SidebarScroller" Grid.Row="1" Margin="8,0,0,8" RequestedTheme="Dark"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="Sidebar" Padding="14,14,14,12" MinHeight="{Binding ViewportHeight, ElementName=SidebarScroller}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="20" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:NavigationRail x:Name="NavigationRail" />
        <Grid x:Name="RailPortrait" Grid.Row="1" Margin="0,8,0,0" SizeChanged="OnRailPortraitSizeChanged"
              IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
        <controls:TaskCard x:Name="TaskCard" Grid.Row="2" />
        <Button x:Name="CollapseButton" Grid.Row="3" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCollapseClick"
                AutomationProperties.Name="收起侧栏" ToolTipService.ToolTip="收起侧栏" Style="{StaticResource SidebarIconButtonStyle}">
          <FontIcon x:Name="CollapseGlyph" Glyph="&#xE76B;" FontSize="13" />
        </Button>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,12,12">
      <Grid x:Name="WorkspaceContent" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:BrowserBar x:Name="BrowserBar" />
        <Grid Grid.Row="1" CornerRadius="{StaticResource ContentCornerRadius}"
              Background="Transparent">
          <controls:BrowserShell x:Name="Browser" Margin="1" />
        </Grid>
      </Grid>
      <Frame x:Name="RootFrame" Visibility="Collapsed" Background="Transparent" IsNavigationStackEnabled="False"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <InfoBar x:Name="ShellBanner"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="16"
                 MaxWidth="720"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Stretch"
                 RequestedTheme="Dark"
                 Background="{ThemeResource ShellBannerBackground}"
                 BorderBrush="{ThemeResource ShellBannerBorderBrush}"
                 BorderThickness="1"
                 CornerRadius="16">
          <InfoBar.Resources>
            <ResourceDictionary>
              <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                  <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#FFFFFF" />
                  <SolidColorBrush x:Key="InfoBarMessageForeground" Color="#E2DFEC" />
                  <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#A99BDF" />
                  <SolidColorBrush x:Key="InfoBarInformationalSeverityIconForeground" Color="#292638" />
                  <!-- The acrylic is drawn by the inner grid; don't put an opaque severity layer beneath it. -->
                  <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
              </ResourceDictionary.ThemeDictionaries>
              <x:Double x:Key="InfoBarTitleFontSize">16</x:Double>
            </ResourceDictionary>
          </InfoBar.Resources>
          <InfoBar.ActionButton>
            <Button x:Name="ShellBannerAction" Click="OnShellBannerActionClick"
                    CornerRadius="8" Padding="16,6" FontWeight="SemiBold">
              <Button.Resources>
                <ResourceDictionary>
                  <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                      <SolidColorBrush x:Key="ButtonBackground" Color="#EEE8FF" />
                      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" />
                      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D6CCE9" />
                      <SolidColorBrush x:Key="ButtonForeground" Color="#39314F" />
                      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#39314F" />
                      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#39314F" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                      <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                      <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    </ResourceDictionary>
                  </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
              </Button.Resources>
            </Button>
          </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
  </Grid>
</Window>
